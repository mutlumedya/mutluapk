Merhaba öncelikle benimle hep Türkçe konuş  şimdi sana kod vereceğim bu kodun yapisi ile aynı olacak kotlin KT sekidle ayarla açılış animasyonlu sonra Firebase sistemli ama Firebase şifreleme yap kimse bilmesin içeriği ona göre Luks yap player konusuna sana bırakıyorum lüks bir player olsun %100 kumanda destekli olacak onutma geri tuşa basınca 2 kez uyarı versin öyle çıkış olsun    


<!DOCTYPE html>
<html lang="tr" data-theme="night">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#06070d" />
  <title>Sar Medya · Canlı TV</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      color-scheme: dark;
      --bg: #06070d;
      --bg-2: #0b0d18;
      --surface: rgba(13, 15, 27, 0.82);
      --surface-2: rgba(22, 25, 42, 0.7);
      --card: rgba(17, 19, 34, 0.72);
      --text: #f6f1e6;
      --text-dim: #a7a2b4;
      --text-muted: #5f5c73;

      --gold: #e6c068;
      --gold-2: #f8e5a6;
      --gold-deep: #a97c2c;
      --ice: #7fe3ff;
      --rose: #ff5d8f;
      --mint: #6dffb4;
      --violet: #9f8bff;

      --glow-gold: rgba(230, 192, 104, 0.42);
      --glow-ice: rgba(127, 227, 255, 0.35);
      --glow-rose: rgba(255, 93, 143, 0.45);
      --glow-mint: rgba(109, 255, 180, 0.4);

      --sidebar-w: 316px;
      --radius: 24px;
      --border: rgba(255, 255, 255, 0.075);
      --border-gold: rgba(230, 192, 104, 0.38);
      --item-bg: rgba(255, 255, 255, 0.04);
      --shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
      --shadow-lux: 0 0 0 1px rgba(230,192,104,0.06), 0 30px 80px rgba(0, 0, 0, 0.7);
      --gold-grad: linear-gradient(135deg, #fbeab0 0%, #e6c068 45%, #a97c2c 100%);
      --on-gold: #1a1204;
    }

    html[data-theme="day"] {
      color-scheme: light;
      --bg: #f3efe6;
      --bg-2: #ebe5d6;
      --surface: rgba(255, 253, 247, 0.92);
      --surface-2: rgba(255, 253, 247, 0.85);
      --card: rgba(255, 255, 255, 0.9);
      --text: #17130a;
      --text-dim: #5b5340;
      --text-muted: #9a917a;
      --gold: #9a6d12;
      --gold-2: #7a5408;
      --gold-deep: #6b4806;
      --ice: #0a6e8a;
      --rose: #c4144f;
      --mint: #0a8a55;
      --violet: #5b3fd1;
      --glow-gold: rgba(154, 109, 18, 0.28);
      --glow-ice: rgba(10, 110, 138, 0.22);
      --glow-rose: rgba(196, 20, 79, 0.25);
      --glow-mint: rgba(10, 138, 85, 0.25);
      --border: rgba(40, 30, 5, 0.12);
      --border-gold: rgba(154, 109, 18, 0.4);
      --item-bg: rgba(40, 30, 5, 0.045);
      --shadow: 0 24px 60px rgba(60, 40, 0, 0.14);
      --shadow-lux: 0 0 0 1px rgba(154,109,18,0.08), 0 24px 60px rgba(60, 40, 0, 0.16);
      --gold-grad: linear-gradient(135deg, #e9c46a 0%, #b88416 55%, #7a5408 100%);
      --on-gold: #fff8e6;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    html { scroll-padding-top: env(safe-area-inset-top, 0px); }

    body {
      font-family: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--bg);
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
      transition: background 0.5s ease, color 0.5s ease;
    }

    /* Aurora arka plan */
    body::before {
      content: '';
      position: fixed; inset: 0;
      background:
        radial-gradient(60% 50% at 12% 8%, var(--glow-gold) 0%, transparent 70%),
        radial-gradient(50% 45% at 92% 12%, var(--glow-ice) 0%, transparent 70%),
        radial-gradient(60% 50% at 50% 105%, var(--glow-rose) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
      opacity: 0.55;
    }
    /* İnce doku */
    body::after {
      content: '';
      position: fixed; inset: 0;
      background-image: radial-gradient(rgba(255,255,255,0.035) 1px, transparent 1px);
      background-size: 3px 3px;
      pointer-events: none;
      z-index: 0;
      opacity: 0.6;
    }
    html[data-theme="day"] body::after { opacity: 0.25; }

    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; }

    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--gold-grad); border-radius: 10px; }

    :focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }

    /* ============ SPLASH ============ */
    #splash {
      position: fixed; inset: 0;
      background:
        radial-gradient(50% 45% at 50% 42%, rgba(230,192,104,0.16), transparent 70%),
        #04050a;
      z-index: 999999;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: 34px;
      transition: opacity 0.9s ease, visibility 0.9s;
    }
    #splash.hidden { opacity: 0; visibility: hidden; pointer-events: none; }

    .splash-logo-wrap {
      position: relative;
      width: 220px; height: 220px;
      display: grid; place-items: center;
    }
    .splash-ring {
      position: absolute; inset: 0;
      border-radius: 50%;
      border: 1.5px solid transparent;
      border-top-color: #e6c068;
      border-right-color: rgba(230,192,104,0.25);
      animation: splashSpin 3s linear infinite;
      filter: drop-shadow(0 0 14px rgba(230,192,104,0.6));
    }
    .splash-ring:nth-child(2) {
      inset: 14px;
      border-top-color: #7fe3ff;
      border-right-color: rgba(127,227,255,0.2);
      animation-duration: 2.2s; animation-direction: reverse;
      filter: drop-shadow(0 0 12px rgba(127,227,255,0.5));
    }
    .splash-ring:nth-child(3) {
      inset: 28px;
      border-top-color: #f8e5a6;
      border-right-color: rgba(248,229,166,0.2);
      animation-duration: 3.8s;
      filter: drop-shadow(0 0 12px rgba(248,229,166,0.5));
    }
    @keyframes splashSpin { to { transform: rotate(360deg); } }

    .splash-logo {
      width: 138px; height: 138px;
      border-radius: 50%;
      object-fit: cover;
      z-index: 2;
      animation: splashPulse 2.6s ease-in-out infinite;
      filter: drop-shadow(0 0 36px rgba(230,192,104,0.5));
    }
    .splash-mono {
      display: none;
      width: 138px; height: 138px;
      border-radius: 50%;
      place-items: center;
      font-family: 'Syne', sans-serif;
      font-weight: 800; font-size: 56px;
      color: #1a1204;
      background: linear-gradient(135deg, #fbeab0, #e6c068, #a97c2c);
      z-index: 2;
    }
    @keyframes splashPulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.06); }
    }

    .splash-title {
      font-family: 'Syne', sans-serif;
      font-size: 34px; font-weight: 800;
      letter-spacing: 14px;
      padding-left: 14px;
      background: linear-gradient(100deg, #a97c2c 0%, #fbeab0 30%, #e6c068 50%, #fbeab0 70%, #a97c2c 100%);
      background-size: 250% auto;
      -webkit-background-clip: text; background-clip: text; color: transparent;
      animation: shimmer 3s linear infinite;
    }
    @keyframes shimmer {
      0% { background-position: 0% center; }
      100% { background-position: 250% center; }
    }
    .splash-bar {
      width: 220px; height: 2px;
      background: rgba(255,255,255,0.08);
      border-radius: 3px; overflow: hidden;
    }
    .splash-bar::after {
      content: ''; display: block;
      height: 100%; width: 40%;
      background: linear-gradient(90deg, transparent, #e6c068, transparent);
      animation: splashLoad 1.6s ease-in-out infinite;
    }
    @keyframes splashLoad {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(350%); }
    }

    /* ============ TOPBAR ============ */
    .topbar {
      position: fixed;
      top: calc(16px + env(safe-area-inset-top, 0px)); left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 32px);
      max-width: 1520px;
      height: 74px;
      border-radius: 26px;
      padding: 0 16px 0 18px;
      display: flex; align-items: center; gap: 14px;
      background: var(--surface);
      backdrop-filter: blur(28px) saturate(180%);
      -webkit-backdrop-filter: blur(28px) saturate(180%);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-lux), inset 0 1px 0 rgba(255,255,255,0.09);
      z-index: 100;
    }
    .topbar::after {
      content: '';
      position: absolute; left: 8%; right: 8%; bottom: -1px; height: 1px;
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
      opacity: 0.55;
    }

    #menuBtn, .icon-btn {
      width: 48px; height: 48px;
      border-radius: 16px;
      background: var(--item-bg);
      border: 1px solid var(--border);
      cursor: pointer;
      display: grid; place-items: center;
      color: var(--text);
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.3s, box-shadow 0.3s;
      outline: none; flex-shrink: 0;
      position: relative;
    }
    #menuBtn:hover, #menuBtn:focus, .icon-btn:hover, .icon-btn:focus {
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(230,192,104,0.12), 0 10px 28px var(--glow-gold);
      transform: translateY(-2px);
    }
    #menuBtn.active { border-color: var(--gold); box-shadow: 0 0 24px var(--glow-gold); }

    .menu-lines { width: 22px; height: 16px; position: relative; }
    .menu-lines span {
      position: absolute; left: 0;
      height: 2px; border-radius: 2px;
      background: var(--text);
      transition: 0.45s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    }
    .menu-lines span:nth-child(1) { top: 0; width: 100%; }
    .menu-lines span:nth-child(2) { top: 7px; width: 70%; }
    .menu-lines span:nth-child(3) { bottom: 0; width: 46%; }
    #menuBtn.active .menu-lines span:nth-child(1) { top: 7px; transform: rotate(45deg); background: var(--gold); }
    #menuBtn.active .menu-lines span:nth-child(2) { opacity: 0; transform: translateX(-12px); }
    #menuBtn.active .menu-lines span:nth-child(3) { bottom: 7px; width: 100%; transform: rotate(-45deg); background: var(--gold); }

    .brand { display: flex; align-items: center; gap: 13px; flex-shrink: 0; }
    .brand-logo {
      width: 48px; height: 48px;
      border-radius: 50%;
      overflow: hidden;
      position: relative; flex-shrink: 0;
      border: 1.5px solid var(--gold);
      box-shadow: 0 0 22px var(--glow-gold);
      transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
      background: #0a0a12;
      display: grid; place-items: center;
    }
    .brand-logo img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .brand-logo .mono { font-family: 'Syne', sans-serif; font-weight: 800; color: var(--gold); display: none; }
    .brand:hover .brand-logo { transform: rotate(-12deg) scale(1.08); }

    .brand-name {
      font-family: 'Syne', sans-serif;
      font-size: 21px; font-weight: 800;
      letter-spacing: 4px;
      background: linear-gradient(100deg, var(--gold-deep) 0%, var(--gold-2) 35%, var(--gold) 55%, var(--gold-2) 75%, var(--gold-deep) 100%);
      background-size: 250% auto;
      -webkit-background-clip: text; background-clip: text; color: transparent;
      animation: shimmer 6s linear infinite;
      white-space: nowrap;
    }

    .search-wrap {
      flex: 0 1 270px;
      max-width: 540px;
      margin-left: auto;
      position: relative;
      display: flex; align-items: center;
      transition: flex 0.45s cubic-bezier(0.25, 1, 0.5, 1);
    }
    .search-wrap:focus-within { flex: 0 1 540px; }
    .search-wrap input {
      width: 100%; height: 48px;
      border-radius: 16px;
      background: var(--item-bg);
      border: 1px solid var(--border);
      padding: 0 20px 0 48px;
      color: var(--text);
      font-size: 15px; font-family: inherit;
      outline: none;
      transition: border-color 0.3s, box-shadow 0.3s, background 0.3s;
    }
    .search-wrap input::placeholder { color: var(--text-muted); }
    .search-wrap input:focus {
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(230,192,104,0.12), 0 0 28px var(--glow-gold);
      background: rgba(230,192,104,0.05);
    }
    .search-wrap .search-ic {
      position: absolute; left: 16px;
      color: var(--text-dim); pointer-events: none;
      transition: color 0.3s;
    }
    .search-wrap:focus-within .search-ic { color: var(--gold); }

    .top-actions { display: flex; gap: 10px; flex-shrink: 0; }
    .icon-btn.profile-btn, .icon-btn.ai-btn { border-color: rgba(230,192,104,0.28); }

    @media (max-width: 820px) {
      .topbar { padding: 0 12px; gap: 8px; height: 64px; border-radius: 22px; }
      .brand-name { display: none; }
      .brand-logo { width: 40px; height: 40px; }
      .search-wrap { flex: 1 1 auto; margin-left: 0; }
      .search-wrap:focus-within { flex: 1 1 auto; }
      .search-wrap input { height: 42px; font-size: 13px; padding-left: 42px; }
      .search-wrap .search-ic { left: 14px; }
      #menuBtn, .icon-btn { width: 42px; height: 42px; border-radius: 14px; }
      .icon-btn svg { width: 18px; height: 18px; }
    }
    @media (max-width: 420px) {
      .top-actions { gap: 6px; }
      #menuBtn, .icon-btn { width: 38px; height: 38px; }
    }

    /* ============ PROFİL PANELİ ============ */
    .profile-panel {
      position: fixed;
      top: calc(106px + env(safe-area-inset-top, 0px)); right: 16px;
      width: 344px;
      max-width: calc(100% - 32px);
      background: var(--surface);
      backdrop-filter: blur(34px) saturate(180%);
      -webkit-backdrop-filter: blur(34px) saturate(180%);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 22px;
      box-shadow: var(--shadow-lux);
      z-index: 95;
      transform: translateY(-16px) scale(0.96);
      opacity: 0; pointer-events: none;
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      max-height: calc(100vh - 130px);
      overflow-y: auto;
    }
    .profile-panel.show { transform: none; opacity: 1; pointer-events: all; }

    .profile-head {
      display: flex; align-items: center; gap: 14px;
      padding-bottom: 16px; margin-bottom: 8px;
      border-bottom: 1px solid var(--border);
    }
    .profile-avatar {
      width: 58px; height: 58px;
      border-radius: 20px;
      background: var(--gold-grad);
      display: grid; place-items: center;
      font-size: 26px; color: var(--on-gold);
      box-shadow: 0 0 28px var(--glow-gold);
      flex-shrink: 0;
    }
    .profile-info h4 {
      font-family: 'Syne', sans-serif;
      font-size: 17px; font-weight: 800;
      color: var(--text);
    }
    .profile-info p {
      font-size: 12px; margin-top: 4px;
      color: var(--gold); font-weight: 700;
    }
    .profile-section-title {
      font-size: 12px; font-weight: 700;
      color: var(--text-muted);
      margin: 18px 4px 10px;
    }
    .profile-item {
      display: flex; align-items: center; gap: 12px;
      padding: 12px 14px;
      border-radius: 16px;
      background: var(--item-bg);
      border: 1px solid var(--border);
      margin-bottom: 8px;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
      outline: none;
      color: var(--text);
      font-size: 13.5px; font-weight: 700;
      width: 100%; text-align: left;
    }
    .profile-item:hover, .profile-item:focus {
      border-color: var(--gold);
      background: rgba(230,192,104,0.07);
      transform: translateX(4px);
      box-shadow: 0 0 20px var(--glow-gold);
    }
    .profile-item .pi-icon {
      width: 36px; height: 36px;
      border-radius: 12px;
      background: rgba(230,192,104,0.12);
      display: grid; place-items: center;
      flex-shrink: 0; font-size: 16px;
    }
    .profile-item .pi-text { flex: 1; }
    .profile-item .pi-text small {
      display: block; font-size: 11px;
      color: var(--text-dim); font-weight: 500; margin-top: 2px;
    }

    .theme-toggle-btn {
      display: flex; align-items: center; justify-content: space-between;
      padding: 12px 16px;
      border-radius: 16px;
      background: var(--item-bg);
      border: 1px solid var(--border);
      margin: 12px 0 8px;
      cursor: pointer;
      color: var(--text);
      font-size: 13.5px; font-weight: 700;
      width: 100%;
      outline: none;
      transition: all 0.3s;
    }
    .theme-toggle-btn:hover, .theme-toggle-btn:focus {
      border-color: var(--gold);
      box-shadow: 0 0 20px var(--glow-gold);
    }
    .theme-toggle-btn .switch {
      width: 50px; height: 28px;
      border-radius: 14px;
      background: var(--item-bg);
      border: 1px solid var(--border);
      position: relative; flex-shrink: 0;
    }
    .theme-toggle-btn .switch::after {
      content: '';
      position: absolute; top: 3px; left: 3px;
      width: 20px; height: 20px;
      border-radius: 50%;
      background: var(--gold-grad);
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    html[data-theme="day"] .theme-toggle-btn .switch::after { transform: translateX(22px); }

    /* ============ MODALLER ============ */
    .m3u-modal-backdrop, .pass-modal-backdrop {
      position: fixed; inset: 0;
      background: rgba(2, 3, 8, 0.82);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      z-index: 99998;
      display: none;
      align-items: center; justify-content: center;
      padding: 20px;
    }
    .m3u-modal-backdrop.show, .pass-modal-backdrop.show { display: flex; }

    .m3u-modal, .pass-modal {
      background: var(--surface);
      border: 1px solid var(--border-gold);
      border-radius: 30px;
      padding: 32px;
      width: 100%;
      box-shadow: 0 40px 100px rgba(0,0,0,0.8), 0 0 60px var(--glow-gold);
      animation: modalIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative; overflow: hidden;
    }
    .m3u-modal { max-width: 500px; }
    .pass-modal { max-width: 420px; padding: 36px; border-color: rgba(255,93,143,0.45); box-shadow: 0 40px 100px rgba(0,0,0,0.85), 0 0 60px var(--glow-rose); }
    .m3u-modal::before, .pass-modal::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--gold-deep), var(--gold-2), var(--gold), var(--gold-deep));
      background-size: 250% auto;
      animation: shimmer 4s linear infinite;
    }
    .pass-modal::before { background: linear-gradient(90deg, var(--rose), var(--gold), var(--rose)); background-size: 250% auto; }
    @keyframes modalIn {
      from { opacity: 0; transform: scale(0.92) translateY(26px); }
      to { opacity: 1; transform: none; }
    }

    .m3u-modal-title, .pass-modal-title {
      font-family: 'Syne', sans-serif;
      font-size: 22px; font-weight: 800;
      margin-bottom: 8px;
      color: var(--gold-2);
      display: flex; align-items: center; gap: 10px;
    }
    html[data-theme="day"] .m3u-modal-title { color: var(--gold-deep); }
    .pass-modal-title { justify-content: center; color: var(--rose); font-size: 24px; }
    .m3u-modal-sub, .pass-modal-sub {
      color: var(--text-dim);
      font-size: 13px; line-height: 1.6;
      margin-bottom: 22px;
    }
    .pass-modal-sub { text-align: center; }

    .m3u-input {
      width: 100%; height: 52px;
      padding: 0 18px;
      border-radius: 16px;
      background: rgba(0,0,0,0.32);
      border: 1px solid var(--border);
      color: var(--text);
      font-size: 14px; font-family: inherit;
      outline: none; transition: all 0.3s;
      margin-bottom: 14px;
    }
    html[data-theme="day"] .m3u-input, html[data-theme="day"] .pass-input { background: rgba(0,0,0,0.04); }
    .m3u-input:focus {
      border-color: var(--gold);
      box-shadow: 0 0 24px var(--glow-gold);
    }
    .m3u-actions, .pass-actions { display: flex; gap: 10px; margin-top: 6px; }
    .m3u-btn, .pass-btn {
      flex: 1; padding: 14px;
      border-radius: 15px;
      border: none;
      font-weight: 800; font-size: 14px;
      cursor: pointer; outline: none;
      transition: all 0.3s;
    }
    .m3u-btn-primary {
      background: var(--gold-grad);
      color: var(--on-gold);
      box-shadow: 0 6px 24px var(--glow-gold);
    }
    .pass-btn-primary {
      background: linear-gradient(135deg, var(--rose), #c2185b);
      color: #fff;
      box-shadow: 0 6px 26px var(--glow-rose);
    }
    .m3u-btn-primary:hover, .m3u-btn-primary:focus, .pass-btn-primary:hover, .pass-btn-primary:focus { transform: translateY(-3px); }
    .m3u-btn-ghost, .pass-btn-ghost {
      background: var(--item-bg);
      color: var(--text);
      border: 1px solid var(--border);
    }
    .m3u-btn-ghost:hover, .m3u-btn-ghost:focus, .pass-btn-ghost:hover, .pass-btn-ghost:focus { border-color: var(--text-dim); }

    .m3u-list { max-height: 300px; overflow-y: auto; margin-top: 18px; padding-right: 6px; }
    .m3u-empty { text-align: center; color: var(--text-dim); font-size: 13px; padding: 20px 0; }
    .m3u-entry {
      display: flex; align-items: center; gap: 12px;
      padding: 12px 14px;
      border-radius: 16px;
      background: var(--item-bg);
      border: 1px solid var(--border);
      margin-bottom: 8px;
      transition: all 0.3s;
    }
    .m3u-entry:hover { border-color: var(--gold); box-shadow: 0 0 16px var(--glow-gold); }
    .m3u-entry-icon {
      width: 38px; height: 38px;
      border-radius: 12px;
      background: var(--gold-grad);
      display: grid; place-items: center;
      font-size: 16px; flex-shrink: 0;
    }
    .m3u-entry-info { flex: 1; min-width: 0; }
    .m3u-entry-url {
      font-size: 13px; font-weight: 700;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .m3u-entry-meta { font-size: 11px; color: var(--text-dim); margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .m3u-entry-btn {
      width: 34px; height: 34px;
      border-radius: 11px;
      background: var(--item-bg);
      border: 1px solid var(--border);
      color: var(--text);
      display: grid; place-items: center;
      cursor: pointer; outline: none;
      transition: all 0.3s; flex-shrink: 0; font-size: 15px;
    }
    .m3u-entry-btn:hover, .m3u-entry-btn:focus { border-color: var(--gold); box-shadow: 0 0 16px var(--glow-gold); }
    .m3u-entry-btn.del { background: rgba(255,93,143,0.1); border-color: rgba(255,93,143,0.3); }
    .m3u-entry-btn.del:hover, .m3u-entry-btn.del:focus { border-color: var(--rose); box-shadow: 0 0 18px var(--glow-rose); }

    .pass-input {
      width: 100%; height: 58px;
      padding: 0 20px;
      border-radius: 18px;
      background: rgba(0,0,0,0.32);
      border: 1px solid rgba(255,93,143,0.35);
      color: var(--text);
      font-size: 22px; font-weight: 800;
      letter-spacing: 8px; text-align: center;
      font-family: inherit; outline: none;
      transition: all 0.35s; margin-bottom: 18px;
    }
    .pass-input:focus { border-color: var(--rose); box-shadow: 0 0 30px var(--glow-rose); }
    .pass-error { color: var(--rose); font-size: 13px; text-align: center; margin-top: 14px; display: none; }
    .pass-error.show { display: block; }

    /* ============ SİDEBAR ============ */
    .sidebar {
      position: fixed;
      top: calc(106px + env(safe-area-inset-top, 0px)); left: 16px;
      width: var(--sidebar-w);
      height: calc(100vh - 130px - env(safe-area-inset-top, 0px));
      background: var(--surface);
      backdrop-filter: blur(34px) saturate(180%);
      -webkit-backdrop-filter: blur(34px) saturate(180%);
      border: 1px solid var(--border);
      border-radius: 30px;
      padding: 24px 16px;
      transform: translateX(calc(-100% - 30px)) scale(0.96);
      opacity: 0;
      transition: all 0.6s cubic-bezier(0.25, 1, 0.4, 1);
      z-index: 90;
      overflow-y: auto;
      box-shadow: var(--shadow-lux), inset 0 1px 0 rgba(255,255,255,0.07);
      visibility: hidden;
    }
    .sidebar.show { transform: none; opacity: 1; visibility: visible; }

    .sidebar-head {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 14px 18px; margin-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }
    .sidebar-head h3 {
      font-family: 'Syne', sans-serif;
      font-size: 18px; font-weight: 700;
      color: var(--gold);
    }
    .sidebar-head .dot {
      width: 9px; height: 9px; border-radius: 50%;
      background: var(--mint);
      box-shadow: 0 0 12px var(--glow-mint);
      animation: dotPulse 2s ease-in-out infinite;
    }
    @keyframes dotPulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.8); }
    }

    .cat-item {
      display: flex; align-items: center; gap: 14px;
      padding: 11px 14px;
      border-radius: 20px;
      margin-bottom: 6px;
      cursor: pointer;
      border: 1px solid transparent;
      transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
      outline: none;
      position: relative; overflow: hidden;
    }
    .cat-item::before {
      content: '';
      position: absolute; left: 0; top: 20%; bottom: 20%;
      width: 3px;
      background: var(--gold-grad);
      border-radius: 0 3px 3px 0;
      transform: scaleY(0);
      transition: transform 0.35s ease;
    }
    .cat-item:hover, .cat-item:focus {
      background: var(--item-bg);
      transform: translateX(6px);
      border-color: var(--border);
    }
    .cat-item:focus {
      border-color: var(--gold);
      box-shadow: 0 0 22px var(--glow-gold);
    }
    .cat-item.active {
      background: linear-gradient(90deg, rgba(230,192,104,0.12), transparent);
      border-color: var(--border);
    }
    .cat-item.active::before { transform: scaleY(1); }

    .cat-ic {
      width: 40px; height: 40px;
      border-radius: 14px;
      display: grid; place-items: center;
      background: var(--item-bg);
      border: 1px solid var(--border);
      color: var(--text-dim);
      transition: all 0.35s ease; flex-shrink: 0;
    }
    .cat-item.active .cat-ic {
      background: var(--gold-grad);
      color: var(--on-gold);
      border-color: transparent;
      box-shadow: 0 0 20px var(--glow-gold);
    }
    .cat-item:hover .cat-ic { transform: rotate(-8deg) scale(1.08); }

    .cat-label {
      flex: 1;
      font-size: 14px; font-weight: 600;
      color: var(--text-dim);
      transition: color 0.3s;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .cat-item.active .cat-label { color: var(--text); font-weight: 800; }

    .cat-count {
      font-size: 11px; font-weight: 800;
      padding: 4px 11px;
      border-radius: 22px;
      background: var(--item-bg);
      border: 1px solid var(--border);
      color: var(--text-muted);
      transition: all 0.35s; flex-shrink: 0;
    }
    .cat-item.active .cat-count { background: var(--gold-grad); color: var(--on-gold); border-color: transparent; }

    .cat-item.adult .cat-ic { background: rgba(255,93,143,0.14); color: var(--rose); border-color: rgba(255,93,143,0.3); }
    .cat-item.adult.active .cat-ic { background: linear-gradient(135deg, #ff5d8f, #c2185b); color: #fff; box-shadow: 0 0 22px var(--glow-rose); }
    .cat-item.adult .cat-label { color: var(--rose); }
    .cat-item.adult.active .cat-label { color: var(--text); }

    .cat-item.m3u .cat-ic { background: rgba(127,227,255,0.1); color: var(--ice); border-color: rgba(127,227,255,0.28); }
    .cat-item.m3u.active .cat-ic { background: linear-gradient(135deg, #7fe3ff, #3aa8d8); color: #04202b; box-shadow: 0 0 22px var(--glow-ice); }

    .overlay {
      position: fixed; inset: 0;
      background: rgba(2, 3, 8, 0.7);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      opacity: 0; pointer-events: none;
      transition: opacity 0.5s; z-index: 80;
    }
    .overlay.show { opacity: 1; pointer-events: all; }

    /* ============ ANA İÇERİK ============ */
    main {
      position: relative; z-index: 5;
      margin-top: calc(118px + env(safe-area-inset-top, 0px));
      padding: 0 3% 80px;
      max-width: 1740px;
      margin-left: auto; margin-right: auto;
    }

    .page-head {
      display: flex; align-items: flex-end; justify-content: space-between;
      gap: 20px; margin-bottom: 34px; flex-wrap: wrap;
      padding: 0 4px;
    }
    .page-title-wrap { display: flex; flex-direction: column; gap: 10px; }
    .page-kicker {
      font-size: 13px; font-weight: 700;
      color: var(--gold);
      display: flex; align-items: center; gap: 12px;
    }
    .page-kicker::before {
      content: '';
      width: 34px; height: 2px;
      background: linear-gradient(90deg, var(--gold), transparent);
      border-radius: 2px;
    }
    .page-title {
      font-family: 'Syne', sans-serif;
      font-size: clamp(32px, 5.4vw, 58px);
      font-weight: 800;
      letter-spacing: -1.5px;
      line-height: 1.04;
      background: linear-gradient(100deg, var(--text) 0%, var(--text) 40%, var(--gold-2) 55%, var(--text) 70%, var(--text) 100%);
      background-size: 250% auto;
      -webkit-background-clip: text; background-clip: text; color: transparent;
      animation: shimmer 9s linear infinite;
    }
    .page-badge {
      font-size: 13px; font-weight: 700;
      padding: 12px 22px;
      border-radius: 32px;
      background: var(--item-bg);
      border: 1px solid var(--border-gold);
      color: var(--gold);
      display: flex; align-items: center; gap: 10px;
      box-shadow: 0 0 26px rgba(230,192,104,0.1);
    }
    .page-badge .badge-dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--mint);
      box-shadow: 0 0 10px var(--glow-mint);
    }

    /* ============ KART IZGARASI ============ */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(208px, 1fr));
      gap: 22px;
    }
    .grid.list-view { display: flex; flex-direction: column; gap: 12px; }
    .grid.list-view .card { flex-direction: row; height: 96px; align-items: stretch; }
    .grid.list-view .card-thumb { width: 170px; height: 100%; aspect-ratio: auto; flex-shrink: 0; }
    .grid.list-view .card-info { flex: 1; padding: 0 72px 0 26px; justify-content: flex-start; background: none; }
    .grid.list-view .ch-name { font-size: 18px; flex: 0 1 auto; }
    .grid.list-view .fav-btn { top: 50%; right: 22px; transform: translateY(-50%); }
    .grid.list-view .fav-btn:hover, .grid.list-view .fav-btn:focus { transform: translateY(-50%) scale(1.12); }
    .grid.list-view .play-overlay { display: none; }
    .grid.list-view .card:hover, .grid.list-view .card:focus { transform: translateX(6px); }

    @media (max-width: 700px) {
      .grid:not(.list-view) { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; }
      .grid.list-view .card { height: 80px; }
      .grid.list-view .card-thumb { width: 130px; }
      .grid.list-view .ch-name { font-size: 15px; }
      .grid.list-view .card-info { padding: 0 60px 0 18px; }
    }
    @media (max-width: 380px) {
      .grid:not(.list-view) { grid-template-columns: repeat(auto-fill, minmax(135px, 1fr)); gap: 12px; }
    }

    @keyframes cardIn {
      from { opacity: 0; transform: translateY(18px); }
      to { opacity: 1; transform: none; }
    }

    .card {
      position: relative;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      cursor: pointer; outline: none;
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      display: flex; flex-direction: column;
      transition: transform 0.35s cubic-bezier(0.25, 1, 0.4, 1), box-shadow 0.35s, border-color 0.3s;
      animation: cardIn 0.5s cubic-bezier(0.25, 1, 0.4, 1) both;
      box-shadow: 0 10px 24px rgba(0,0,0,0.3);
    }
    html[data-theme="day"] .card { box-shadow: 0 10px 24px rgba(60,40,0,0.1); }
    .card::before {
      content: '';
      position: absolute; top: 0; left: 12%; right: 12%; height: 1px;
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
      opacity: 0.35; z-index: 5;
      transition: opacity 0.3s;
    }
    .card:hover, .card:focus {
      transform: translateY(-7px) scale(1.025);
      box-shadow: 0 24px 50px rgba(0,0,0,0.55), 0 0 0 1px var(--gold), 0 0 40px var(--glow-gold);
      border-color: var(--gold);
      z-index: 10;
    }
    .card:hover::before, .card:focus::before { opacity: 1; }

    .card-thumb {
      width: 100%;
      aspect-ratio: 16 / 10;
      position: relative;
      display: flex; align-items: center; justify-content: center;
      overflow: hidden;
      transition: background 0.5s ease;
    }
    .card-thumb::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 55%);
      pointer-events: none; z-index: 1;
    }
    .channel-logo {
      width: 64%; height: 64%;
      object-fit: contain; z-index: 2;
      filter: drop-shadow(0 6px 14px rgba(0,0,0,0.5));
      transition: transform 0.4s cubic-bezier(0.25, 1, 0.4, 1);
    }
    .card:hover .channel-logo, .card:focus .channel-logo { transform: scale(1.14) translateY(-4px); }

    .thumb-text {
      font-family: 'Syne', sans-serif;
      font-size: 30px; font-weight: 800;
      color: rgba(255,255,255,0.95);
      letter-spacing: 3px; z-index: 2;
      text-shadow: 0 6px 20px rgba(0,0,0,0.7);
    }

    .fav-btn {
      position: absolute;
      top: 12px; right: 12px;
      width: 38px; height: 38px;
      border-radius: 13px;
      background: rgba(0,0,0,0.5);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.16);
      display: grid; place-items: center;
      color: #fff; font-size: 17px;
      z-index: 6;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      outline: none; cursor: pointer; line-height: 1;
    }
    .fav-btn:hover, .fav-btn:focus {
      background: rgba(255,93,143,0.3);
      border-color: var(--rose); color: var(--rose);
      transform: scale(1.14);
      box-shadow: 0 0 22px var(--glow-rose);
    }
    .fav-btn.active {
      background: linear-gradient(135deg, var(--rose), #c2185b);
      color: #fff; border-color: transparent;
      box-shadow: 0 0 22px var(--glow-rose);
    }

    .play-overlay {
      position: absolute; inset: 0;
      background: rgba(0,0,0,0.45);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity 0.3s;
      z-index: 4; pointer-events: none;
    }
    .play-icon {
      width: 58px; height: 58px;
      border-radius: 50%;
      background: var(--gold-grad);
      display: grid; place-items: center;
      color: #1a1204;
      transform: scale(0.65);
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 8px 28px rgba(0,0,0,0.6), 0 0 40px var(--glow-gold);
    }
    .play-icon svg { margin-left: 4px; }
    .card:hover .play-overlay, .card:focus .play-overlay { opacity: 1; }
    .card:hover .play-icon, .card:focus .play-icon { transform: scale(1); }

    .card-info {
      padding: 15px 18px 17px;
      position: relative; z-index: 2;
      display: flex; align-items: center; justify-content: space-between;
      gap: 10px;
      background: linear-gradient(to top, rgba(6,7,13,0.55), transparent);
    }
    html[data-theme="day"] .card-info { background: none; }
    .ch-name {
      font-size: 15px; font-weight: 700;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      color: var(--text); flex: 1;
    }
    .live-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--mint);
      box-shadow: 0 0 10px var(--glow-mint);
      flex-shrink: 0;
      animation: dotPulse 2s ease-in-out infinite;
    }

    .loading-state {
      grid-column: 1/-1;
      text-align: center;
      padding: 80px 20px;
      color: var(--text-dim);
      font-size: 15px;
      display: flex; flex-direction: column;
      align-items: center; gap: 20px;
    }
    .loader {
      width: 54px; height: 54px;
      border-radius: 50%;
      border: 3px solid var(--border);
      border-top-color: var(--gold);
      border-right-color: var(--gold-deep);
      animation: spin 0.9s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ============ AI SOHBET ============ */
    .ai-chat-panel {
      position: fixed;
      bottom: calc(24px + env(safe-area-inset-bottom, 0px)); right: 24px;
      width: 384px;
      max-height: 570px;
      background: var(--surface);
      backdrop-filter: blur(38px) saturate(190%);
      -webkit-backdrop-filter: blur(38px) saturate(190%);
      border: 1px solid var(--border-gold);
      border-radius: 28px;
      box-shadow: 0 30px 80px rgba(0,0,0,0.75), 0 0 60px rgba(230,192,104,0.16);
      z-index: 9999;
      display: flex; flex-direction: column;
      overflow: hidden;
      transform: translateY(110%) scale(0.92);
      opacity: 0;
      transition: all 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
      pointer-events: none;
    }
    .ai-chat-panel.open { transform: none; opacity: 1; pointer-events: all; }

    .ai-chat-header {
      display: flex; align-items: center; gap: 12px;
      padding: 18px 20px;
      border-bottom: 1px solid var(--border);
      background: linear-gradient(135deg, rgba(230,192,104,0.1), rgba(127,227,255,0.04));
    }
    .ai-avatar {
      width: 42px; height: 42px;
      border-radius: 15px;
      background: var(--gold-grad);
      display: grid; place-items: center;
      font-size: 20px;
      box-shadow: 0 0 22px var(--glow-gold);
      flex-shrink: 0;
    }
    .ai-header-info { flex: 1; }
    .ai-header-info h4 {
      font-family: 'Syne', sans-serif;
      font-size: 16px; font-weight: 800;
      color: var(--gold-2);
    }
    html[data-theme="day"] .ai-header-info h4 { color: var(--gold-deep); }
    .ai-header-info p {
      font-size: 11.5px; color: var(--text-dim);
      margin-top: 2px;
      display: flex; align-items: center; gap: 6px;
    }
    .ai-online-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 8px var(--glow-mint); }
    .ai-close-btn {
      width: 36px; height: 36px;
      border-radius: 12px;
      background: var(--item-bg);
      border: 1px solid var(--border);
      color: var(--text-dim);
      display: grid; place-items: center;
      cursor: pointer; outline: none;
      transition: all 0.3s; flex-shrink: 0;
    }
    .ai-close-btn:hover, .ai-close-btn:focus { border-color: var(--rose); color: var(--rose); box-shadow: 0 0 18px var(--glow-rose); }

    .ai-chat-messages {
      flex: 1; overflow-y: auto;
      padding: 18px;
      display: flex; flex-direction: column; gap: 12px;
      min-height: 200px; max-height: 340px;
      scroll-behavior: smooth;
    }
    .ai-msg {
      max-width: 86%;
      padding: 12px 16px;
      border-radius: 18px;
      font-size: 13.5px; line-height: 1.6;
      animation: msgIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      word-wrap: break-word;
      white-space: pre-line;
    }
    @keyframes msgIn {
      from { opacity: 0; transform: translateY(10px) scale(0.96); }
      to { opacity: 1; transform: none; }
    }
    .ai-msg.bot {
      align-self: flex-start;
      background: rgba(230,192,104,0.08);
      border: 1px solid rgba(230,192,104,0.22);
      border-bottom-left-radius: 6px;
    }
    .ai-msg.user {
      align-self: flex-end;
      background: rgba(127,227,255,0.09);
      border: 1px solid rgba(127,227,255,0.24);
      border-bottom-right-radius: 6px;
    }
    .ai-msg .msg-label { font-size: 11px; font-weight: 800; margin-bottom: 5px; opacity: 0.85; }
    .ai-msg.bot .msg-label { color: var(--gold); }
    .ai-msg.user .msg-label { color: var(--ice); text-align: right; }

    .ai-typing {
      display: flex; gap: 5px;
      padding: 14px 18px;
      align-self: flex-start;
      background: rgba(230,192,104,0.08);
      border: 1px solid rgba(230,192,104,0.22);
      border-radius: 18px; border-bottom-left-radius: 6px;
    }
    .ai-typing span { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); animation: typingBounce 1.4s ease-in-out infinite; }
    .ai-typing span:nth-child(2) { animation-delay: 0.2s; }
    .ai-typing span:nth-child(3) { animation-delay: 0.4s; }
    @keyframes typingBounce {
      0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
      30% { transform: translateY(-8px); opacity: 1; }
    }

    .ai-chat-input-wrap {
      display: flex; gap: 10px;
      padding: 16px 18px;
      border-top: 1px solid var(--border);
      background: rgba(0,0,0,0.12);
    }
    .ai-chat-input {
      flex: 1; height: 46px;
      border-radius: 15px;
      background: var(--item-bg);
      border: 1px solid var(--border);
      padding: 0 16px;
      color: var(--text);
      font-size: 13.5px; font-family: inherit;
      outline: none; transition: all 0.3s;
    }
    .ai-chat-input::placeholder { color: var(--text-muted); }
    .ai-chat-input:focus { border-color: var(--gold); box-shadow: 0 0 20px var(--glow-gold); }
    .ai-send-btn {
      width: 46px; height: 46px;
      border-radius: 15px;
      background: var(--gold-grad);
      border: none; color: var(--on-gold);
      display: grid; place-items: center;
      cursor: pointer; outline: none;
      transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      flex-shrink: 0;
    }
    .ai-send-btn:hover, .ai-send-btn:focus { transform: scale(1.08) rotate(-5deg); box-shadow: 0 0 28px var(--glow-gold); }

    .ai-quick-actions { display: flex; gap: 8px; padding: 0 18px 14px; flex-wrap: wrap; }
    .ai-quick-btn {
      padding: 7px 14px;
      border-radius: 20px;
      background: var(--item-bg);
      border: 1px solid var(--border);
      color: var(--text-dim);
      font-size: 12px; font-weight: 700;
      cursor: pointer; outline: none;
      transition: all 0.3s;
    }
    .ai-quick-btn:hover, .ai-quick-btn:focus { border-color: var(--gold); color: var(--gold); box-shadow: 0 0 16px var(--glow-gold); }

    @media (max-width: 480px) {
      .ai-chat-panel { width: calc(100% - 24px); right: 12px; bottom: calc(12px + env(safe-area-inset-bottom, 0px)); max-height: 72vh; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body>

<div id="splash">
