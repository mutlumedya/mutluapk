</div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import { getDatabase, ref, onValue, set } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js";

/* ============ AYARLAR ============ */
const TELEGRAM_URL = "https://t.me/sarmedya";   // Telegram bağlantını buraya yaz
const APP_VERSION  = "1.0";

const firebaseConfig = {
  apiKey: "AIzaSyA9iUuAMK4hrqLQEARG-4IjBrOSzaIIDQk",
  authDomain: "kazan-beab9.firebaseapp.com",
  databaseURL: "https://kazan-beab9-default-rtdb.firebaseio.com",
  projectId: "kazan-beab9",
  storageBucket: "kazan-beab9.appspot.com",
  messagingSenderId: "278987454292",
  appId: "1:278987454292:web:7e8400b4e43fd0fb847ac1",
  measurementId: "G-W6KNZVH324"
};

const app = initializeApp(firebaseConfig);
const db = getDatabase(app);

const CATEGORIES_PATH = 'sarmedya-kategoriler';
const CHANNELS_PATH   = 'sarmedya-kanallar';
const ADULT_PATH      = 'sarmedya-adult-kanallar';
const ADULT_PASS_PATH = 'sarmedya-adult-sifre';
const M3U_FB_PATH     = 'sarmedya-m3u-listeleri';

const ADULT_CAT_ID = '__ADULT__';
const M3U_CAT_ID   = '__M3U__';

let categories = [];
let channels = [];
let firebaseCategories = {};
let firebaseChannels = {};
let firebaseAdultChannels = {};
let adultPassword = '';
let adultUnlocked = false;

let m3uLists = [];
let m3uChannels = [];

/* ============ YARDIMCILAR ============ */
function svg(inner){
  return '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + inner + '</svg>';
}
const favIcon = svg('<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>');
const adultIcon = svg('<circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>');
const m3uIcon = svg('<path d="M4 6h16M4 12h16M4 18h10"></path><circle cx="19" cy="18" r="2"></circle>');
const defaultIcon = svg('<rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect><polyline points="17 2 12 7 7 2"></polyline>');

const iconDictionary = {
  haber: svg('<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8l-4 4v14a2 2 0 0 0 2 2z"></path><line x1="14" y1="2" x2="14" y2="8"></line><line x1="14" y1="8" x2="20" y2="8"></line><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line>'),
  belgesel: svg('<path d="M12 2.69l5.66 4.12A8 8 0 1 1 6.34 6.81L12 2.69z"></path>'),
  sinema: svg('<rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect><line x1="7" y1="2" x2="7" y2="22"></line><line x1="17" y1="2" x2="17" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"></line>'),
  spor: svg('<circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>'),
  cocuk: svg('<circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line>'),
  muzik: svg('<path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle>'),
  dini: svg('<path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path>'),
  ulusal: svg('<circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>')
};

function getCatSymbol(id, label){
  if(id === 'favoriler') return favIcon;
  if(id === ADULT_CAT_ID) return adultIcon;
  if(id === M3U_CAT_ID) return m3uIcon;
  const s = (id + label).toLowerCase();
  if(s.includes('haber')) return iconDictionary.haber;
  if(s.includes('belgesel') || s.includes('doğa')) return iconDictionary.belgesel;
  if(s.includes('sinema') || s.includes('film')) return iconDictionary.sinema;
  if(s.includes('spor') || s.includes('sport')) return iconDictionary.spor;
  if(s.includes('çocuk') || s.includes('cocuk')) return iconDictionary.cocuk;
  if(s.includes('müzik') || s.includes('muzik')) return iconDictionary.muzik;
  if(s.includes('dini') || s.includes('din')) return iconDictionary.dini;
  if(s.includes('ulusal')) return iconDictionary.ulusal;
  return defaultIcon;
}

function slugify(str){
  return (str||'').toLowerCase()
    .replace(/ç/g,'c').replace(/ğ/g,'g').replace(/ı/g,'i').replace(/i̇/g,'i')
    .replace(/ö/g,'o').replace(/ş/g,'s').replace(/ü/g,'u')
    .replace(/[^a-z0-9]/g, '');
}

function esc(s){
  return String(s == null ? '' : s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function trUpper(s){ return String(s||'').toLocaleUpperCase('tr-TR'); }
function trLower(s){ return String(s||'').toLocaleLowerCase('tr-TR'); }

const fallbackGradients = [
  "linear-gradient(135deg, rgba(230, 192, 104, 0.42), rgba(8, 10, 20, 0.96))",
  "linear-gradient(135deg, rgba(127, 227, 255, 0.34), rgba(8, 10, 20, 0.96))",
  "linear-gradient(135deg, rgba(255, 93, 143, 0.36), rgba(8, 10, 20, 0.96))",
  "linear-gradient(135deg, rgba(159, 139, 255, 0.4), rgba(8, 10, 20, 0.96))",
  "linear-gradient(135deg, rgba(109, 255, 180, 0.3), rgba(8, 10, 20, 0.96))"
];
function getFallbackColor(str){
  let hash = 0;
  for(let i = 0; i < str.length; i++){ hash = str.charCodeAt(i) + ((hash << 5) - hash); }
  return fallbackGradients[Math.abs(hash) % fallbackGradients.length];
}

/* ============ DOM ============ */
const $ = id => document.getElementById(id);
const sidebar = $('sidebar'), overlay = $('overlay'), menuBtn = $('menuBtn'), catList = $('catList');
const grid = $('grid'), pageTitle = $('pageTitle'), pageCount = $('pageCount');
const viewToggle = $('viewToggle'), viewIcon = $('viewIcon'), searchInput = $('searchInput');
const passModal = $('passModal'), passInput = $('passInput'), passError = $('passError');
const profileBtn = $('profileBtn'), profilePanel = $('profilePanel'), profileThemeToggle = $('profileThemeToggle');
const profileM3uBtn = $('profileM3uBtn'), profileClearFavs = $('profileClearFavs'), profileAboutBtn = $('profileAboutBtn');
const m3uModal = $('m3uModal'), m3uInput = $('m3uInput'), m3uAddBtn = $('m3uAddBtn'), m3uCloseBtn = $('m3uCloseBtn'), m3uList = $('m3uList');
const aiToggle = $('aiToggle'), aiChatPanel = $('aiChatPanel'), aiCloseBtn = $('aiCloseBtn');
const aiMessages = $('aiMessages'), aiInput = $('aiInput'), aiSendBtn = $('aiSendBtn');

$('telegramLink').setAttribute('href', TELEGRAM_URL);

// Logo yüklenemezse monogram göster
$('splashLogo').addEventListener('error', e => { e.target.style.display = 'none'; $('splashMono').style.display = 'grid'; });
$('brandImg').addEventListener('error', e => { e.target.style.display = 'none'; $('brandMono').style.display = 'block'; });

let activeCat = '';
let favorites = [];
let searchQuery = '';
let isListView = false;
let cardNodes = [];
let currentCardIndex = 0;
let cardsPerRow = 1;
let hasInteracted = false;
let isDataReady = false;
let aiChatOpen = false;
let profileOpen = false;

try{
  const sf = JSON.parse(localStorage.getItem('sarmedya_favs') || '[]');
  if(Array.isArray(sf)) favorites = sf;
  if(localStorage.getItem('sarmedya_view') === 'list') isListView = true;
  const sm3u = JSON.parse(localStorage.getItem('sarmedya_m3u') || '[]');
  if(Array.isArray(sm3u)) m3uLists = sm3u;
  const sm3uCh = JSON.parse(localStorage.getItem('sarmedya_m3u_channels') || '[]');
  if(Array.isArray(sm3uCh)) m3uChannels = sm3uCh;
}catch(e){ favorites = []; m3uLists = []; m3uChannels = []; }

function saveM3uLocal(){
  try{
    localStorage.setItem('sarmedya_m3u', JSON.stringify(m3uLists));
    localStorage.setItem('sarmedya_m3u_channels', JSON.stringify(m3uChannels));
  }catch(e){}
}

/* ============ M3U ============ */
function parseM3UName(url){
  try{
    const u = new URL(url);
    const parts = u.pathname.split('/').filter(Boolean);
    if(parts.length){
      const last = parts[parts.length-1].replace(/\.(m3u8?|txt)$/i,'');
      if(last) return decodeURIComponent(last);
    }
    return u.hostname;
  }catch(e){ return 'M3U Liste'; }
}

function parseM3UContent(text){
  const lines = text.split(/\r?\n/);
  const out = [];
  let current = null;
  for(const raw of lines){
    const line = raw.trim();
    if(!line) continue;
    if(line.startsWith('#EXTINF')){
      const nameMatch = line.match(/,(.+)$/);
      const logoMatch = line.match(/tvg-logo="([^"]*)"/i);
      const groupMatch = line.match(/group-title="([^"]*)"/i);
      current = {
        name: nameMatch ? nameMatch[1].trim() : 'Kanal',
        logo: logoMatch ? logoMatch[1] : '',
        group: groupMatch ? groupMatch[1] : ''
      };
    } else if(/^https?:/i.test(line) && current){
      current.url = line;
      out.push(current);
      current = null;
    }
  }
  return out;
}

async function fetchM3UContent(url){
  try{
    const res = await fetch(url, { mode: 'cors' });
    if(!res.ok) throw new Error('HTTP ' + res.status);
    return parseM3UContent(await res.text());
  }catch(e){
    console.warn('M3U fetch failed:', e);
    return [];
  }
}

function toM3uChannels(chs, name, url){
  return chs.map((c, i) => ({
    id: 'm3u_' + name.replace(/\s+/g,'_') + '_' + i,
    title: c.name,
    logo: c.logo || '',
    ref: c.url,
    cat: M3U_CAT_ID,
    letter: c.name.substring(0,4).toLocaleUpperCase('tr-TR'),
    isM3u: true,
    m3uSource: url
  }));
}

/* ============ KATEGORİLER ============ */
function buildCategories(){
  catList.innerHTML = '';
  const frag = document.createDocumentFragment();
  categories.forEach(cat=>{
    const node = document.createElement('div');
    node.className = 'cat-item' + (cat.id === activeCat ? ' active' : '') + (cat.isAdult ? ' adult' : '') + (cat.isM3u ? ' m3u' : '');
    node.dataset.id = cat.id;
    node.tabIndex = (cat.id === activeCat && sidebar.classList.contains('show')) ? 0 : -1;
    node.setAttribute('role', 'button');

    const ic = document.createElement('div');
    ic.className = 'cat-ic';
    ic.innerHTML = cat.icon;
    node.appendChild(ic);

    const label = document.createElement('div');
    label.className = 'cat-label';
    label.textContent = cat.label;
    node.appendChild(label);

    let count = 0;
    if(cat.id === 'favoriler') count = favorites.length;
    else if(cat.id === ADULT_CAT_ID) count = Object.values(firebaseAdultChannels).filter(c => c && c.name && c.active !== false).length;
    else if(cat.id === M3U_CAT_ID) count = m3uChannels.length;
    else count = channels.filter(c => c.cat === cat.id).length;

    const cDiv = document.createElement('div');
    cDiv.className = 'cat-count';
    cDiv.textContent = String(count);
    node.appendChild(cDiv);

    node.addEventListener('click', () => selectCategory(cat.id));
    node.addEventListener('keydown', e=>{
      if(isEnterKey(e)) selectCategory(cat.id);
      if(isRightKey(e) && sidebar.classList.contains('show')){
        e.preventDefault();
        closeSidebar();
        if(cardNodes.length) focusCard(0);
      }
    });
    frag.appendChild(node);
  });
  catList.appendChild(frag);
}

function selectCategory(catId){
  if(catId === ADULT_CAT_ID && !adultUnlocked){
    openPassModal();
    return;
  }
  searchInput.value = '';
  searchQuery = '';
  activeCat = catId;
  const cat = categories.find(c => c.id === catId);
  pageTitle.textContent = cat ? cat.label : '';

  document.querySelectorAll('.cat-item').forEach(el=>{
    const isActive = el.dataset.id === activeCat;
    el.classList.toggle('active', isActive);
    el.tabIndex = isActive ? 0 : -1;
  });

  if(document.activeElement) document.activeElement.blur();
  window.scrollTo({ top: 0, behavior: 'smooth' });
  renderGrid();
  closeSidebar();

  if(cardNodes.length && hasInteracted){ setTimeout(()=>focusCard(0), 10); }
}

/* ============ KARTLAR ============ */
function computeCardsPerRow(){
  cardNodes = Array.from(grid.querySelectorAll('.card'));
  if(cardNodes.length === 0){ cardsPerRow = 1; return; }
  if(isListView){ cardsPerRow = 1; return; }
  const firstTop = cardNodes[0].offsetTop;
  let count = 0;
  for(const c of cardNodes){
    if(Math.abs(c.offsetTop - firstTop) < 5) count++; else break;
  }
  cardsPerRow = count || 1;
}

function focusCard(index){
  if(!cardNodes.length) return;
  if(index < 0) index = 0;
  if(index >= cardNodes.length) index = cardNodes.length - 1;
  currentCardIndex = index;
  const el = cardNodes[currentCardIndex];
  if(el){
    hasInteracted = true;
    el.focus({ preventScroll: true });
    el.scrollIntoView({ block: 'center', behavior: 'smooth' });
  }
}

searchInput.addEventListener('input', e=>{
  searchQuery = trLower(e.target.value).trim();
  renderGrid();
});

function openChannel(ch){
  if(ch.ref) window.location.href = ch.ref;
}

function createCard(ch, index){
  const card = document.createElement('div');
  card.className = 'card';
  card.tabIndex = 0;
  card.setAttribute('role', 'listitem');
  card.setAttribute('aria-label', ch.title);
  card.style.animationDelay = (Math.min(index, 30) * 0.025) + 's';

  const thumb = document.createElement('div');
  thumb.className = 'card-thumb';
  thumb.style.background = getFallbackColor((ch.id || '') + ch.title);

  const letterEl = () => {
    const t = document.createElement('div');
    t.className = 'thumb-text';
    t.textContent = ch.letter || '';
    return t;
  };

  if(ch.logo){
    const img = document.createElement('img');
    img.className = 'channel-logo';
    img.src = ch.logo;
    img.alt = ch.title;
    img.loading = 'lazy';
    img.decoding = 'async';
    img.addEventListener('error', () => { img.remove(); thumb.insertBefore(letterEl(), thumb.firstChild); });
    thumb.appendChild(img);
  } else {
    thumb.appendChild(letterEl());
  }

  const po = document.createElement('div');
  po.className = 'play-overlay';
  po.innerHTML = '<div class="play-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"></polygon></svg></div>';
  thumb.appendChild(po);
  card.appendChild(thumb);

  // Logodan baskın rengi al
  if(ch.logo){
    const ghost = new Image();
    ghost.crossOrigin = 'Anonymous';
    ghost.onload = () => {
      try{
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        canvas.width = 40; canvas.height = 40;
        ctx.drawImage(ghost, 0, 0, 40, 40);
        const data = ctx.getImageData(0, 0, 40, 40).data;
        let r = 0, g = 0, b = 0, c = 0;
        for(let i = 0; i < data.length; i += 16){
          if(data[i+3] > 128 && (data[i] > 30 || data[i+1] > 30 || data[i+2] > 30)){
            r += data[i]; g += data[i+1]; b += data[i+2]; c++;
          }
        }
        if(c > 0){
          r = Math.floor(r/c); g = Math.floor(g/c); b = Math.floor(b/c);
          thumb.style.background = 'linear-gradient(135deg, rgba(' + r + ',' + g + ',' + b + ',0.6), rgba(8, 10, 20, 0.96))';
        }
      }catch(err){}
    };
    ghost.src = ch.logo;
  }

  const favBtn = document.createElement('button');
  favBtn.type = 'button';
  favBtn.className = 'fav-btn' + (favorites.includes(ch.id) ? ' active' : '');
  favBtn.textContent = favorites.includes(ch.id) ? '♥' : '♡';
  favBtn.tabIndex = -1;
  favBtn.setAttribute('aria-label', 'Favorilere ekle');
  card.appendChild(favBtn);

  const info = document.createElement('div');
  info.className = 'card-info';
  const nm = document.createElement('div');
  nm.className = 'ch-name';
  nm.textContent = ch.title;
  const dot = document.createElement('div');
  dot.className = 'live-dot';
  info.appendChild(nm);
  info.appendChild(dot);
  card.appendChild(info);

  favBtn.addEventListener('click', e=>{
    e.stopPropagation();
    toggleFav(ch.id);
    favBtn.classList.toggle('active');
    favBtn.textContent = favorites.includes(ch.id) ? '♥' : '♡';
    if(activeCat === 'favoriler' && !searchQuery){
      if(document.activeElement) document.activeElement.blur();
      renderGrid();
      setTimeout(()=>focusCard(currentCardIndex), 10);
    } else {
      const favCat = catList.querySelector('.cat-item[data-id="favoriler"] .cat-count');
      if(favCat) favCat.textContent = String(favorites.length);
    }
  });

  card.addEventListener('click', () => openChannel(ch));
  card.addEventListener('keydown', e=>{ if(isEnterKey(e)) openChannel(ch); });
  card.addEventListener('focus', ()=>{
    const idx = cardNodes.indexOf(card);
    if(idx !== -1) currentCardIndex = idx;
  });

  return card;
}

function renderGrid(){
  let list = [];

  if(searchQuery){
    const allCh = [...channels, ...m3uChannels];
    list = allCh.filter(ch => trLower(ch.title).includes(searchQuery));
    pageTitle.textContent = 'Arama sonuçları';
  } else if(activeCat === ADULT_CAT_ID){
    if(adultUnlocked){
      list = Object.entries(firebaseAdultChannels)
        .map(([k, v]) => ({ fbKey: k, ...v }))
        .filter(c => c && c.name && c.active !== false)
        .sort((a, b) => (a.order || 0) - (b.order || 0))
        .map(c => ({
          id: c.fbKey,
          title: c.name,
          logo: c.logo || '',
          ref: c.url || '',
          cat: ADULT_CAT_ID,
          letter: trUpper(c.name.substring(0, 4))
        }));
    }
    pageTitle.textContent = 'ADULT';
  } else if(activeCat === M3U_CAT_ID){
    list = m3uChannels;
    pageTitle.textContent = 'M3U İÇERİKLERİ';
  } else {
    list = activeCat === 'favoriler'
      ? [...channels, ...m3uChannels].filter(ch => favorites.includes(ch.id))
      : channels.filter(ch => ch.cat === activeCat);
    const cat = categories.find(c => c.id === activeCat);
    pageTitle.textContent = cat ? cat.label : 'Kanallar';
  }

  const countEl = pageCount.querySelector('span:last-child');
  if(countEl) countEl.textContent = list.length + ' kanal';

  while(grid.firstChild) grid.removeChild(grid.firstChild);

  if(list.length === 0){
    const msg = document.createElement('div');
    msg.className = 'loading-state';
    msg.textContent = searchQuery
      ? 'Aramana uygun kanal bulunamadı. Farklı bir kelime dene.'
      : (activeCat === M3U_CAT_ID
          ? 'Henüz M3U içeriği yok. Profil menüsünden bir liste ekleyebilirsin.'
          : 'Bu kategoride henüz kanal yok.');
    grid.appendChild(msg);
    cardNodes = [];
    return;
  }

  const frag = document.createDocumentFragment();
  list.forEach((ch, index) => frag.appendChild(createCard(ch, index)));
  grid.appendChild(frag);

  requestAnimationFrame(()=>{
    cardNodes = Array.from(grid.querySelectorAll('.card'));
    computeCardsPerRow();
  });
}

function toggleFav(id){
  if(favorites.includes(id)) favorites = favorites.filter(x => x !== id);
  else favorites.push(id);
  try{ localStorage.setItem('sarmedya_favs', JSON.stringify(favorites)); }catch(e){}
}

/* ============ SIDEBAR ============ */
function openSidebar(){
  closeProfilePanel();
  sidebar.classList.add('show');
  overlay.classList.add('show');
  sidebar.setAttribute('aria-hidden', 'false');
  overlay.setAttribute('aria-hidden', 'false');
  menuBtn.classList.add('active');
  setTimeout(()=>{
    const activeEl = catList.querySelector('.cat-item.active') || catList.querySelector('.cat-item');
    if(activeEl) activeEl.focus();
  }, 0);
}
function closeSidebar(){
  sidebar.classList.remove('show');
  overlay.classList.remove('show');
  sidebar.setAttribute('aria-hidden', 'true');
  overlay.setAttribute('aria-hidden', 'true');
  menuBtn.classList.remove('active');
}
menuBtn.addEventListener('click', e=>{
  e.stopPropagation();
  sidebar.classList.contains('show') ? closeSidebar() : openSidebar();
});
overlay.addEventListener('click', e=>{ e.stopPropagation(); closeSidebar(); });

/* ============ PROFİL ============ */
function openProfilePanel(){
  closeSidebar();
  profilePanel.classList.add('show');
  profileOpen = true;
  updateProfileThemeUI();
}
function closeProfilePanel(){
  profilePanel.classList.remove('show');
  profileOpen = false;
}
profileBtn.addEventListener('click', e=>{
  e.stopPropagation();
  profileOpen ? closeProfilePanel() : openProfilePanel();
});
document.addEventListener('click', e=>{
  if(profileOpen && !profilePanel.contains(e.target) && e.target !== profileBtn && !profileBtn.contains(e.target)){
    closeProfilePanel();
  }
});
profilePanel.addEventListener('click', e => e.stopPropagation());

function updateProfileThemeUI(){
  const cur = document.documentElement.getAttribute('data-theme') || 'night';
  const label = profileThemeToggle.querySelector('span:first-child');
  if(label) label.textContent = cur === 'day' ? '☀️ Gündüz modu' : '🌙 Gece modu';
}
profileThemeToggle.addEventListener('click', ()=>{
  const cur = document.documentElement.getAttribute('data-theme') || 'night';
  setTheme(cur === 'day' ? 'night' : 'day');
});

profileM3uBtn.addEventListener('click', ()=>{ closeProfilePanel(); openM3uModal(); });

profileClearFavs.addEventListener('click', ()=>{
  if(confirm('Tüm favoriler silinsin mi?')){
    favorites = [];
    try{ localStorage.setItem('sarmedya_favs', '[]'); }catch(e){}
    const favCat = catList.querySelector('.cat-item[data-id="favoriler"] .cat-count');
    if(favCat) favCat.textContent = '0';
    if(activeCat === 'favoriler') renderGrid();
    closeProfilePanel();
  }
});

profileAboutBtn.addEventListener('click', ()=>{
  alert("SAR MEDYA\n\nDijital Canlı TV Platformu\nSürüm: " + APP_VERSION + "\n\n© 2026 Sar Medya\nTüm hakları saklıdır.");
});

/* ============ M3U MODAL ============ */
function openM3uModal(){
  closeProfilePanel();
  m3uModal.classList.add('show');
  m3uInput.value = '';
  renderM3uList();
  setTimeout(()=>m3uInput.focus(), 200);
}
function closeM3uModal(){ m3uModal.classList.remove('show'); }

m3uCloseBtn.addEventListener('click', closeM3uModal);
m3uModal.addEventListener('click', e=>{ if(e.target === m3uModal) closeM3uModal(); });
m3uAddBtn.addEventListener('click', addM3uList);
m3uInput.addEventListener('keydown', e=>{
  if(e.key === 'Enter'){ e.preventDefault(); addM3uList(); }
});

async function loadM3uSource(entry){
  const chs = await fetchM3UContent(entry.url);
  if(chs.length > 0){
    m3uChannels = m3uChannels.filter(c => c.m3uSource !== entry.url).concat(toM3uChannels(chs, entry.name, entry.url));
    saveM3uLocal();
    updateM3uCount();
    if(activeCat === M3U_CAT_ID) renderGrid();
  }
  return chs.length;
}

async function addM3uList(){
  const url = m3uInput.value.trim();
  if(!url){ alert('Lütfen bir M3U bağlantısı gir.'); return; }
  if(!/^https?:\/\//i.test(url)){ alert('Geçerli bir http veya https bağlantısı gir.'); return; }
  if(m3uLists.some(m => m.url === url)){ alert('Bu liste zaten ekli.'); return; }

  const name = parseM3UName(url);
  const entry = { url, name, addedAt: Date.now() };

  m3uLists.push(entry);
  saveM3uLocal();
  m3uInput.value = '';
  renderM3uList();
  updateM3uCount();

  try{
    const key = 'm3u_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
    await set(ref(db, M3U_FB_PATH + '/' + key), entry);
  }catch(e){ console.warn('Firebase m3u sync failed:', e); }

  showM3uLoading();
  const n = await loadM3uSource(entry);
  renderM3uList();

  if(n > 0){
    alert('✅ ' + n + ' kanal eklendi.\n\nSol menüdeki "M3U İÇERİKLERİ" kategorisinden izleyebilirsin.');
    closeM3uModal();
  } else {
    alert('⚠️ Liste kaydedildi ama içerik alınamadı.\n\nNedeni CORS engeli veya bağlantı sorunu olabilir. Başka bir ağdan tekrar deneyebilirsin.');
  }
}

function showM3uLoading(){
  m3uList.innerHTML = '<div class="m3u-empty" style="color:var(--gold)">⏳ M3U içeriği yükleniyor...</div>';
}

function renderM3uList(){
  m3uList.innerHTML = '';
  if(m3uLists.length === 0){
    m3uList.innerHTML = '<div class="m3u-empty">Henüz M3U listesi eklenmemiş.</div>';
    return;
  }
  m3uLists.forEach((m, idx)=>{
    const chCount = m3uChannels.filter(c => c.m3uSource === m.url).length;
    const shortUrl = (m.url || '').substring(0, 40) + ((m.url || '').length > 40 ? '...' : '');

    const entry = document.createElement('div');
    entry.className = 'm3u-entry';
    entry.innerHTML =
      '<div class="m3u-entry-icon">📡</div>' +
      '<div class="m3u-entry-info">' +
        '<div class="m3u-entry-url">' + esc(m.name || 'M3U Liste') + '</div>' +
        '<div class="m3u-entry-meta">' + chCount + ' kanal · ' + esc(shortUrl) + '</div>' +
      '</div>' +
      '<button class="m3u-entry-btn refresh" type="button" aria-label="Yenile">↻</button>' +
      '<button class="m3u-entry-btn del" type="button" aria-label="Sil">🗑️</button>';

    entry.querySelector('.refresh').addEventListener('click', async ()=>{
      showM3uLoading();
      await loadM3uSource(m);
      renderM3uList();
    });
    entry.querySelector('.del').addEventListener('click', ()=>removeM3u(idx));
    m3uList.appendChild(entry);
  });
}

function removeM3u(idx){
  if(!confirm("Bu M3U listesi silinsin mi?\n\n(Not: Firebase'de yedek olarak saklanmaya devam eder.)")) return;
  const removed = m3uLists[idx];
  m3uLists.splice(idx, 1);
  if(removed) m3uChannels = m3uChannels.filter(c => c.m3uSource !== removed.url);
  saveM3uLocal();
  renderM3uList();
  updateM3uCount();
  if(activeCat === M3U_CAT_ID) renderGrid();
}

function updateM3uCount(){
  const cnt = catList.querySelector('.cat-item[data-id="' + M3U_CAT_ID + '"] .cat-count');
  if(cnt) cnt.textContent = String(m3uChannels.length);
}

// Firebase'den M3U listelerini çek ve birleştir
onValue(ref(db, M3U_FB_PATH), snap=>{
  const data = snap.val() || {};
  const fbList = Object.values(data).filter(x => x && x.url);
  if(fbList.length === 0) return;
  let changed = false;
  fbList.forEach(fb=>{
    if(!m3uLists.find(m => m.url === fb.url)){
      m3uLists.push({ url: fb.url, name: fb.name || parseM3UName(fb.url), addedAt: fb.addedAt || Date.now() });
      changed = true;
    }
  });
  if(changed){
    saveM3uLocal();
    renderM3uList();
    updateM3uCount();
    if(activeCat === M3U_CAT_ID) renderGrid();
  }
});

/* ============ KUMANDA / KLAVYE ============ */
function isLeftKey(e)  { return e.key === 'ArrowLeft'  || e.key === 'Left'  || e.keyCode === 37 || e.keyCode === 21; }
function isRightKey(e) { return e.key === 'ArrowRight' || e.key === 'Right' || e.keyCode === 39 || e.keyCode === 22; }
function isUpKey(e)    { return e.key === 'ArrowUp'    || e.key === 'Up'    || e.keyCode === 38 || e.keyCode === 19; }
function isDownKey(e)  { return e.key === 'ArrowDown'  || e.key === 'Down'  || e.keyCode === 40 || e.keyCode === 20; }
function isBackKey(e)  { return e.key === 'Escape' || e.key === 'Backspace' || e.keyCode === 8 || e.keyCode === 27 || e.keyCode === 4; }
function isEnterKey(e) { return e.key === 'Enter' || e.keyCode === 13 || e.keyCode === 23 || e.keyCode === 66; }

document.addEventListener('keydown', function(e){

  if(m3uModal.classList.contains('show')){
    if(isBackKey(e) && document.activeElement !== m3uInput){ e.preventDefault(); closeM3uModal(); return; }
    if(e.key === 'Escape'){ e.preventDefault(); closeM3uModal(); }
    return;
  }

  if(passModal.classList.contains('show')){
    if(isBackKey(e) && document.activeElement !== passInput){ e.preventDefault(); closePassModal(); return; }
    if(e.key === 'Escape'){ e.preventDefault(); closePassModal(); return; }
    if(isEnterKey(e) && document.activeElement !== passInput){ e.preventDefault(); tryPass(); return; }
    return;
  }

  const active = document.activeElement;

  // AI sohbet yazarken kumanda tuşlarına karışma
  if(active === aiInput){
    if(e.key === 'Escape'){ toggleAIChat(false); aiToggle.focus(); }
    return;
  }

  if(active === searchInput){
    if(isLeftKey(e) || isRightKey(e) || isBackKey(e)) return;
    if(isDownKey(e) || isEnterKey(e)){
      e.preventDefault();
      if(cardNodes.length) focusCard(0);
      return;
    }
  }

  if(!hasInteracted && (isUpKey(e) || isDownKey(e) || isLeftKey(e) || isRightKey(e) || isEnterKey(e))){
    hasInteracted = true;
    if(sidebar.classList.contains('show')){
      const activeCatEl = catList.querySelector('.cat-item.active');
      if(activeCatEl) activeCatEl.focus();
    } else if(cardNodes.length > 0){
      focusCard(0);
    }
  }

  const isCard = active && active.classList.contains('card');
  const isCat = active && active.classList.contains('cat-item');
  const isTopBar = active === menuBtn || active === searchInput || active === viewToggle || active === profileBtn || active === aiToggle;

  if(sidebar.classList.contains('show') && isCat){
    const cats = Array.from(catList.querySelectorAll('.cat-item'));
    const i = cats.indexOf(active);

    if(isDownKey(e)){ e.preventDefault(); if(i < cats.length - 1) cats[i+1].focus(); return; }
    if(isUpKey(e)){ e.preventDefault(); if(i > 0) cats[i-1].focus(); else menuBtn.focus(); return; }
    if(isBackKey(e) || isLeftKey(e)){
      e.preventDefault();
      closeSidebar();
      if(cardNodes.length) focusCard(currentCardIndex);
      return;
    }
    if(isRightKey(e)){ e.preventDefault(); selectCategory(active.dataset.id); return; }
  }

  if(isCard){
    e.preventDefault();

    if(isUpKey(e)){
      if(currentCardIndex < cardsPerRow){
        if(currentCardIndex > cardsPerRow / 2) searchInput.focus();
        else menuBtn.focus();
        return;
      }
      focusCard(currentCardIndex - cardsPerRow);
      return;
    }
    if(isDownKey(e)){ focusCard(currentCardIndex + cardsPerRow); return; }
    if(isLeftKey(e)){
      if(currentCardIndex % cardsPerRow === 0) openSidebar();
      else focusCard(currentCardIndex - 1);
      return;
    }
    if(isRightKey(e)){
      if(isListView) return;
      if(currentCardIndex < cardNodes.length - 1) focusCard(currentCardIndex + 1);
      return;
    }
    if(isEnterKey(e)){ active.click(); return; }
  }

  const topOrder = [menuBtn, searchInput, viewToggle, profileBtn, aiToggle];
  if(isTopBar){
    const i = topOrder.indexOf(active);
    if(isRightKey(e)){ e.preventDefault(); if(i < topOrder.length - 1) topOrder[i+1].focus(); return; }
    if(isLeftKey(e)){ e.preventDefault(); if(i > 0) topOrder[i-1].focus(); return; }
    if(isDownKey(e)){
      e.preventDefault();
      if(active === menuBtn && sidebar.classList.contains('show')){
        const activeCatEl = catList.querySelector('.cat-item.active') || catList.querySelector('.cat-item');
        if(activeCatEl) activeCatEl.focus();
      } else if(cardNodes.length){
        focusCard(0);
      }
      return;
    }
    if(isEnterKey(e)){
      if(active !== searchInput){ e.preventDefault(); active.click(); }
      return;
    }
  }

  if(isBackKey(e)){
    if(aiChatOpen){ e.preventDefault(); toggleAIChat(false); return; }
    if(profileOpen){ e.preventDefault(); closeProfilePanel(); return; }
    if(sidebar.classList.contains('show')){
      e.preventDefault();
      closeSidebar();
      if(cardNodes.length) focusCard(currentCardIndex);
      else menuBtn.focus();
      return;
    }
  }
});

/* ============ ADULT ŞİFRE ============ */
function openPassModal(){
  closeSidebar();
  closeProfilePanel();
  passModal.classList.add('show');
  passError.classList.remove('show');
  passInput.value = '';
  setTimeout(()=>passInput.focus(), 100);
}
function closePassModal(){
  passModal.classList.remove('show');
  passError.classList.remove('show');
}
function tryPass(){
  const val = passInput.value.trim();
  if(!adultPassword){
    passError.textContent = '❌ Adult şifresi henüz ayarlanmamış.';
    passError.classList.add('show');
    return;
  }
  if(val === String(adultPassword)){
    adultUnlocked = true;
    closePassModal();
    activeCat = ADULT_CAT_ID;
    const cat = categories.find(c => c.id === ADULT_CAT_ID);
    pageTitle.textContent = cat ? cat.label : 'ADULT';
    document.querySelectorAll('.cat-item').forEach(el=>{
      el.classList.toggle('active', el.dataset.id === activeCat);
    });
    renderGrid();
  } else {
    passError.textContent = '❌ Yanlış şifre, tekrar dene.';
    passError.classList.add('show');
    passInput.value = '';
    passInput.focus();
  }
}
$('passConfirm').addEventListener('click', tryPass);
$('passCancel').addEventListener('click', closePassModal);
passInput.addEventListener('keydown', e=>{
  if(e.key === 'Enter' || e.keyCode === 13){ e.preventDefault(); tryPass(); }
});

/* ============ TEMA / GÖRÜNÜM ============ */
function setTheme(t){
  document.documentElement.setAttribute('data-theme', t);
  const meta = document.querySelector('meta[name="theme-color"]');
  if(meta) meta.setAttribute('content', t === 'day' ? '#f3efe6' : '#06070d');
  try{ localStorage.setItem('sarmedya_theme', t); }catch(e){}
  updateProfileThemeUI();
}

const LIST_ICON = '<line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line>';
const GRID_ICON = '<rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect>';

function applyViewMode(isList){
  isListView = isList;
  grid.classList.toggle('list-view', isListView);
  viewIcon.innerHTML = isListView ? GRID_ICON : LIST_ICON;
  try{ localStorage.setItem('sarmedya_view', isListView ? 'list' : 'grid'); }catch(e){}
  computeCardsPerRow();
}
viewToggle.addEventListener('click', ()=>{
  applyViewMode(!isListView);
  if(cardNodes.length && currentCardIndex > -1) focusCard(currentCardIndex);
});

/* ============ AI SOHBET ============ */
function toggleAIChat(forceState){
  const open = (typeof forceState === 'boolean') ? forceState : !aiChatOpen;
  aiChatOpen = open;
  aiChatPanel.classList.toggle('open', open);
  if(open){
    closeProfilePanel();
    setTimeout(()=>aiInput.focus(), 200);
  }
}
aiToggle.addEventListener('click', ()=>toggleAIChat());
aiCloseBtn.addEventListener('click', ()=>toggleAIChat(false));

function addAIMessage(text, sender){
  const msg = document.createElement('div');
  msg.className = 'ai-msg ' + sender;
  const label = document.createElement('div');
  label.className = 'msg-label';
  label.textContent = sender === 'bot' ? 'Sar Medya AI' : 'Sen';
  msg.appendChild(label);
  msg.appendChild(document.createTextNode(text));
  aiMessages.appendChild(msg);
  aiMessages.scrollTop = aiMessages.scrollHeight;
}
function showTypingIndicator(){
  const typing = document.createElement('div');
  typing.className = 'ai-typing';
  typing.id = 'aiTypingIndicator';
  typing.innerHTML = '<span></span><span></span><span></span>';
  aiMessages.appendChild(typing);
  aiMessages.scrollTop = aiMessages.scrollHeight;
}
function removeTypingIndicator(){
  const el = $('aiTypingIndicator');
  if(el) el.remove();
}

const aiResponses = {
  nedir: "Sar Medya, canlı TV kanallarını tek yerde toplayan modern bir yayın platformudur. 🎬 Şık arayüzü, geniş kanal listesi ve M3U desteğiyle öne çıkar.",
  izle: "Kanalları izlemek çok kolay! 📺 Sol menüden bir kategori seç ya da arama çubuğunu kullan, ardından kanal kartına tıkla.",
  favori: "Favorilere eklemek için kanal kartının sağ üstündeki kalp simgesine tıkla. ❤️ Hepsini sol menüdeki FAVORİLER kategorisinde bulursun.",
  m3u: "M3U listesi, IPTV yayınlarını içeren bir bağlantı dosyasıdır. 📡 Profil menüsünden \"M3U listesi\" seçeneğiyle kendi listeni ekleyebilirsin. İçerikler \"M3U İÇERİKLERİ\" kategorisinde görünür.",
  profil: "Profil menüsüne üst bardaki 👤 simgesinden ulaşabilirsin. Tema, M3U listesi, favoriler ve daha fazlası orada.",
  adult: "Adult bölümünün şifresi güvenlik nedeniyle paylaşılamaz. 🔒",
  tema: "Temayı değiştirmek için profil menüsündeki gece/gündüz düğmesine dokun. 🌙☀️",
  telegram: "Telegram kanalımıza katılmak için profil menüsündeki ✈️ Telegram seçeneğine tıkla.",
  yardim: "Şunları sorabilirsin:\n• Sar Medya nedir?\n• Kanalları nasıl izlerim?\n• M3U listesi nedir?\n• Favorilere nasıl eklerim?",
  merhaba: "Merhaba! 👋 Sar Medya AI asistanına hoş geldin. Sana nasıl yardımcı olabilirim?",
  tesekkur: "Rica ederim! 😊 Başka bir sorun olursa buradayım.",
  ucretsiz: "Sar Medya'yı kullanmak için herhangi bir ücret ödemen gerekmez. 🎉",
  varsayilan: "Bu konuda yardımcı olmak isterim! 🤖 Daha belirli bir soru sorabilirsin. Örneğin: \"Sar Medya nedir?\", \"M3U listesi nedir?\" ya da \"Favorilere nasıl eklerim?\""
};

function getAIResponse(userText){
  const l = trLower(userText).trim();
  if(l.includes('m3u')) return aiResponses.m3u;
  if(l.includes('profil')) return aiResponses.profil;
  if(l.includes('sar medya') || l.includes('sarmedya')) return aiResponses.nedir;
  if(l.includes('kanal') && (l.includes('izle'))) return aiResponses.izle;
  if(l.includes('favori') || l.includes('kalp')) return aiResponses.favori;
  if(l.includes('adult') || l.includes('şifre') || l.includes('sifre')) return aiResponses.adult;
  if(l.includes('tema') || l.includes('gece') || l.includes('gündüz')) return aiResponses.tema;
  if(l.includes('telegram')) return aiResponses.telegram;
  if(l.includes('merhaba') || l.includes('selam')) return aiResponses.merhaba;
  if(l.includes('teşekkür') || l.includes('sağ ol') || l.includes('sag ol')) return aiResponses.tesekkur;
  if(l.includes('ücretsiz') || l.includes('bedava')) return aiResponses.ucretsiz;
  if(l.includes('yardım') || l.includes('nasıl')) return aiResponses.yardim;
  return aiResponses.varsayilan;
}

function askAI(text){
  addAIMessage(text, 'user');
  showTypingIndicator();
  setTimeout(()=>{
    removeTypingIndicator();
    addAIMessage(getAIResponse(text), 'bot');
  }, 400 + Math.random() * 500);
}

function sendAIMessage(){
  const text = aiInput.value.trim();
  if(!text) return;
  aiInput.value = '';
  askAI(text);
}
aiSendBtn.addEventListener('click', sendAIMessage);
aiInput.addEventListener('keydown', e=>{
  if(e.key === 'Enter' || e.keyCode === 13){ e.preventDefault(); sendAIMessage(); }
});
document.querySelectorAll('.ai-quick-btn').forEach(btn=>{
  btn.addEventListener('click', ()=>{ if(btn.dataset.q) askAI(btn.dataset.q); });
});

/* ============ FIREBASE VERİSİ ============ */
function buildDataFromFirebase(){
  const cats = [];
  cats.push({ id: M3U_CAT_ID, label: 'M3U İÇERİKLERİ', icon: m3uIcon, isM3u: true });
  cats.push({ id: 'favoriler', label: 'FAVORİLER', icon: favIcon });

  const fbCatArray = Object.entries(firebaseCategories)
    .map(([key, val]) => ({ fbKey: key, ...val }))
    .filter(c => c && c.name && c.active !== false)
    .sort((a, b) => {
      const ao = (a.order !== undefined) ? a.order : 999999;
      const bo = (b.order !== undefined) ? b.order : 999999;
      return ao - bo;
    });

  fbCatArray.forEach(c=>{
    const catId = slugify(c.name);
    cats.push({ id: catId, label: trUpper(c.name), icon: getCatSymbol(catId, c.name) });
  });

  const adultActive = Object.values(firebaseAdultChannels).filter(c => c && c.name && c.active !== false).length;
  if(adultActive > 0){
    cats.push({ id: ADULT_CAT_ID, label: 'ADULT', icon: adultIcon, isAdult: true });
  }
  categories = cats;

  const chs = [];
  Object.entries(firebaseChannels).forEach(([key, val])=>{
    if(!val || !val.name) return;
    if(val.active === false) return;
    const chCatId = slugify(val.category || '');
    if(!fbCatArray.find(c => slugify(c.name) === chCatId)) return;

    chs.push({
      id: key,
      title: val.name,
      logo: val.logo || '',
      ref: val.url || '',
      cat: chCatId,
      catLabel: val.category || '',
      letter: trUpper(val.name.substring(0, 4)),
      order: (val.order !== undefined) ? val.order : 999999,
      createdAt: val.createdAt || 0
    });
  });

  chs.sort((a, b)=>{
    if(a.order !== b.order) return a.order - b.order;
    return b.createdAt - a.createdAt;
  });
  channels = chs;

  buildCategories();

  if(!categories.find(c => c.id === activeCat)){
    const firstReal = categories.find(c => c.id !== 'favoriler' && c.id !== ADULT_CAT_ID && c.id !== M3U_CAT_ID);
    activeCat = firstReal ? firstReal.id : M3U_CAT_ID;
  }
  renderGrid();
}

onValue(ref(db, CATEGORIES_PATH), snapshot=>{
  firebaseCategories = snapshot.val() || {};
  isDataReady = true;
  buildDataFromFirebase();
});
onValue(ref(db, CHANNELS_PATH), snapshot=>{
  firebaseChannels = snapshot.val() || {};
  isDataReady = true;
  buildDataFromFirebase();
});
onValue(ref(db, ADULT_PATH), snapshot=>{
  firebaseAdultChannels = snapshot.val() || {};
  buildDataFromFirebase();
});
onValue(ref(db, ADULT_PASS_PATH), snapshot=>{
  adultPassword = snapshot.val() || '';
  adultUnlocked = false;
  buildCategories();
});

/* ============ AÇILIŞ ============ */
window.addEventListener('load', ()=>{
  setTimeout(()=>{
    const splash = $('splash');
    if(splash) splash.classList.add('hidden');
  }, 2200);
});

(function init(){
  let savedTheme = 'night';
  try{ savedTheme = localStorage.getItem('sarmedya_theme') || 'night'; }catch(e){}
  setTheme(savedTheme);
  applyViewMode(isListView);

  setTimeout(()=>{
    if(!isDataReady){
      grid.innerHTML = '<div class="loading-state">Veri yüklenemedi. İnternet bağlantını kontrol edip sayfayı yenile.</div>';
    }
  }, 6000);
})();
</script>

</body>
</html>
