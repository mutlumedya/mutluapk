<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Max Tv — IPTV</title>

<!-- Tema flaşını önlemek için boyamadan ÖNCE uygula -->
<script>
  (function(){
    try{
      var t = localStorage.getItem('fplay_theme');
      if(t === 'light') document.documentElement.setAttribute('data-theme','light');
    }catch(e){}
  })();
</script>

<!-- Tailwind (utility) -->
<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
<!-- HLS oynatıcı -->
<script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.13/dist/hls.min.js"></script>
<!-- Font -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
/* ══════════════════════════════════════════════
   Max Tv — SPATIAL / GLASSMORPHISM TEMA MOTORU
   ══════════════════════════════════════════════ */
:root{
  --ease: cubic-bezier(.22,1,.36,1);
  --ease-b: cubic-bezier(.34,1.56,.64,1);
  --a1:#22d3ee;  /* cyan   */
  --a2:#a78bfa;  /* mor    */
  --a3:#f472b6;  /* magenta*/
  --danger:#fb4d6d;
}
[data-theme="dark"]{
  --bg:#050610;
  --text:#eef2ff;
  --muted:#8a92ac;
  --glass:rgba(17,19,36,.58);
  --glass-strong:rgba(14,16,30,.78);
  --glass-soft:rgba(255,255,255,.05);
  --stroke:rgba(255,255,255,.09);
  --stroke-hi:rgba(255,255,255,.18);
  --shadow:0 24px 60px -12px rgba(0,0,0,.65);
  --card-fb-1:#171a33;
  --card-fb-2:#0b1a26;
  --thumb-base:#0a0c1a;
  --input-bg:rgba(255,255,255,.06);
  --aurora-op:.55;
  color-scheme:dark;
}
[data-theme="light"]{
  --bg:#dde4f2;
  --text:#0d1226;
  --muted:#5d667e;
  --glass:rgba(255,255,255,.6);
  --glass-strong:rgba(255,255,255,.82);
  --glass-soft:rgba(255,255,255,.55);
  --stroke:rgba(13,18,38,.1);
  --stroke-hi:rgba(13,18,38,.18);
  --shadow:0 24px 55px -18px rgba(70,85,140,.4);
  --card-fb-1:#cdd7f2;
  --card-fb-2:#d7ecf5;
  --thumb-base:#c3cdea;
  --input-bg:rgba(255,255,255,.65);
  --aurora-op:.35;
  color-scheme:light;
}

*{ box-sizing:border-box; }
html{ scroll-behavior:smooth; }
body{
  margin:0; min-height:100vh; overflow-x:hidden;
  font-family:'Plus Jakarta Sans',system-ui,sans-serif;
  background:var(--bg); color:var(--text);
  transition:background .5s ease,color .5s ease;
  -webkit-font-smoothing:antialiased;
}
::selection{ background:rgba(34,211,238,.35); }
body::-webkit-scrollbar{ width:10px; }
body::-webkit-scrollbar-thumb{ background:linear-gradient(var(--a2),var(--a1)); border-radius:99px; }
body::-webkit-scrollbar-track{ background:transparent; }
button{ font-family:inherit; }
:focus-visible{ outline:2px solid var(--a1); outline-offset:2px; border-radius:12px; }

/* ── Ambiyans: aurora lekeleri ───────────────── */
.aurora{ position:fixed; border-radius:50%; filter:blur(120px); opacity:var(--aurora-op); pointer-events:none; z-index:0;
  transition:opacity .6s ease; will-change:transform; }
.aurora.a{ width:52vw; height:52vw; top:-18vw; left:-14vw; background:radial-gradient(circle,#123a8f,transparent 65%); animation:drift1 26s ease-in-out infinite alternate; }
.aurora.b{ width:44vw; height:44vw; top:30vh; right:-16vw; background:radial-gradient(circle,#5b2b8f,transparent 65%); animation:drift2 32s ease-in-out infinite alternate; }
.aurora.c{ width:40vw; height:40vw; bottom:-18vw; left:24vw; background:radial-gradient(circle,#0e5a6b,transparent 65%); animation:drift1 38s ease-in-out infinite alternate-reverse; }
@keyframes drift1{ to{ transform:translate(6vw,5vh) scale(1.12);} }
@keyframes drift2{ to{ transform:translate(-5vw,-6vh) scale(.94);} }

/* ══════════════════════════════════════════════
   SPLASH / INTRO
   ══════════════════════════════════════════════ */
#splash{ position:fixed; inset:0; z-index:1000; display:grid; place-items:center;
  background:radial-gradient(120% 120% at 50% 20%, #0b0e1e 0%, #03040a 60%);
  opacity:1; visibility:visible;
  transition:opacity .65s ease .1s, visibility 0s .8s; }
#splash.done{ opacity:0; visibility:hidden; pointer-events:none; }
.splash-wrap{ position:relative; width:150px; height:150px; display:grid; place-items:center; }
.splash-ring{ position:absolute; inset:0; border-radius:50%;
  border:2.5px solid transparent; border-top-color:var(--a1); border-right-color:rgba(167,139,250,.65);
  filter:drop-shadow(0 0 10px rgba(34,211,238,.55));
  animation:spin 1.3s linear infinite; }
.splash-ring.r2{ inset:-14px; border-top-color:var(--a3); border-right-color:transparent;
  border-left-color:rgba(34,211,238,.35); animation-duration:2.3s; animation-direction:reverse;
  filter:drop-shadow(0 0 12px rgba(244,114,182,.4)); }
.splash-ring.r3{ inset:-28px; border-color:transparent transparent rgba(255,255,255,.14) transparent; animation-duration:3.6s; }
.splash-logo{ width:106px; height:106px; border-radius:50%; object-fit:cover;
  box-shadow:0 0 0 2px rgba(255,255,255,.12), 0 0 44px rgba(34,211,238,.35), 0 0 90px rgba(167,139,250,.25);
  animation:logoIn .9s var(--ease-b) .15s both; }
.splash-txt{ position:absolute; bottom:-58px; left:50%; transform:translateX(-50%);
  font-weight:800; letter-spacing:.5em; font-size:13px; color:#9fb2ff; text-indent:.5em;
  animation:fadeUp 1s var(--ease) .35s both; white-space:nowrap; }
@keyframes spin{ to{ transform:rotate(360deg);} }
@keyframes logoIn{ from{ opacity:0; transform:scale(.55);} to{ opacity:1; transform:scale(1);} }
@keyframes fadeUp{ from{ opacity:0; transform:translate(-50%,10px);} to{ opacity:1; transform:translate(-50%,0);} }

/* ══════════════════════════════════════════════
   TOPBAR (yüzen cam bar)
   ══════════════════════════════════════════════ */
#topbar{
  position:fixed; top:16px; left:50%; transform:translateX(-50%);
  width:min(1180px, calc(100% - 28px));
  display:flex; align-items:center; gap:10px;
  padding:9px 12px; border-radius:24px; z-index:120;
  background:var(--glass); border:1px solid var(--stroke);
  backdrop-filter:blur(22px) saturate(160%); -webkit-backdrop-filter:blur(22px) saturate(160%);
  box-shadow:var(--shadow);
  animation:barIn .8s var(--ease) .2s both;
}
@keyframes barIn{ from{ opacity:0; transform:translate(-50%,-24px);} to{ opacity:1; transform:translate(-50%,0);} }

.tbtn{ position:relative; width:44px; height:44px; flex:0 0 44px; border-radius:50%;
  display:grid; place-items:center; cursor:pointer;
  background:var(--glass-soft); border:1px solid var(--stroke); color:var(--text);
  transition:transform .35s var(--ease), box-shadow .35s var(--ease), border-color .3s, background .3s; }
.tbtn:hover{ transform:translateY(-3px); border-color:rgba(34,211,238,.55);
  box-shadow:0 0 0 1px rgba(34,211,238,.35), 0 8px 24px -4px rgba(34,211,238,.4), 0 0 18px rgba(167,139,250,.25); }
.tbtn:active{ transform:translateY(-1px) scale(.96); }
.tbtn svg{ width:20px; height:20px; }
.tbtn.kv-focus{ border-color:var(--a1); box-shadow:0 0 0 2px rgba(34,211,238,.5), 0 0 22px rgba(34,211,238,.45); transform:translateY(-3px); }

/* Hamburger → X animasyonu */
.burger{ display:flex; flex-direction:column; gap:4.5px; align-items:center; justify-content:center; }
.burger span{ display:block; width:19px; height:2px; border-radius:2px; background:currentColor;
  transition:transform .4s var(--ease), opacity .25s; }
.burger.open span:nth-child(1){ transform:translateY(6.5px) rotate(45deg); }
.burger.open span:nth-child(2){ opacity:0; transform:scaleX(.3); }
.burger.open span:nth-child(3){ transform:translateY(-6.5px) rotate(-45deg); }

.brand{ display:flex; align-items:center; gap:11px; text-decoration:none; color:var(--text); user-select:none; }
.brand img{ width:42px; height:42px; border-radius:14px; object-fit:cover;
  transform:rotate(-8deg); border:1px solid var(--stroke-hi);
  box-shadow:0 6px 18px -4px rgba(34,211,238,.4);
  transition:transform .45s var(--ease-b), box-shadow .4s; }
.brand:hover img{ transform:rotate(0deg) scale(1.05); box-shadow:0 8px 26px -4px rgba(167,139,250,.5); }
.brand b{ font-size:18px; font-weight:800; letter-spacing:.12em;
  background:linear-gradient(100deg,#7dd3fc,var(--a2) 55%,var(--a3));
  -webkit-background-clip:text; background-clip:text; color:transparent; }

/* Arama */
.search{ flex:1 1 auto; display:flex; align-items:center; gap:9px;
  min-width:0; max-width:210px; height:44px; padding:0 15px; border-radius:999px;
  background:var(--input-bg); border:1px solid var(--stroke);
  transition:max-width .5s var(--ease), border-color .3s, box-shadow .35s; }
.search:focus-within{ max-width:340px; border-color:rgba(34,211,238,.6);
  box-shadow:0 0 0 1px rgba(34,211,238,.3), 0 0 24px -4px rgba(34,211,238,.35); }
.search svg{ width:17px; height:17px; flex:0 0 17px; color:var(--muted); }
.search input{ flex:1; min-width:0; background:none; border:0; outline:0; color:var(--text);
  font:500 14px 'Plus Jakarta Sans'; }
.search input::placeholder{ color:var(--muted); }

.top-actions{ display:flex; align-items:center; gap:9px; margin-left:auto; }

/* ══════════════════════════════════════════════
   SIDEBAR + OVERLAY
   ══════════════════════════════════════════════ */
#overlay{ position:fixed; inset:0; z-index:130; background:rgba(3,5,12,.55);
  backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px);
  opacity:0; pointer-events:none; transition:opacity .45s ease; }
#overlay.show{ opacity:1; pointer-events:auto; }

#sidebar{ position:fixed; z-index:140; left:16px; top:5vh; height:90vh; width:308px; max-width:86vw;
  display:flex; flex-direction:column; border-radius:28px; overflow:hidden;
  background:var(--glass-strong); border:1px solid var(--stroke);
  backdrop-filter:blur(26px) saturate(170%); -webkit-backdrop-filter:blur(26px) saturate(170%);
  box-shadow:var(--shadow);
  transform:translateX(-118%); transition:transform .55s var(--ease); }
#sidebar.open{ transform:translateX(0); }

.side-head{ padding:24px 22px 14px; }
.side-head h2{ margin:0; font-size:11.5px; font-weight:800; letter-spacing:.34em; color:var(--muted); text-transform:uppercase; }
.side-head .line{ margin-top:12px; height:1px; background:linear-gradient(90deg,var(--a1),transparent); opacity:.5; }

.cats{ flex:1; overflow-y:auto; padding:4px 10px 16px; scrollbar-width:thin; }
.cats::-webkit-scrollbar{ width:5px; }
.cats::-webkit-scrollbar-thumb{ background:rgba(140,150,190,.3); border-radius:99px; }

.cat-row{ position:relative; display:flex; align-items:center; gap:12px; width:100%;
  padding:10px 11px; margin:3px 0; border:1px solid transparent; border-radius:16px;
  background:transparent; color:var(--text); cursor:pointer; text-align:left;
  transition:transform .3s var(--ease), background .3s, border-color .3s; }
.cat-row:hover{ transform:translateX(5px); background:var(--glass-soft); }
.cat-row::before{ content:""; position:absolute; left:0; top:10px; bottom:10px; width:3px; border-radius:3px;
  background:linear-gradient(180deg,var(--a1),var(--a2)); box-shadow:0 0 12px var(--a1);
  opacity:0; transition:opacity .3s; }
.cat-row.active{ background:linear-gradient(90deg,rgba(34,211,238,.12),rgba(167,139,250,.07)); border-color:rgba(34,211,238,.22); }
.cat-row.active::before{ opacity:1; }
.cat-row.kv-focus{ border-color:var(--a1); box-shadow:inset 0 0 0 1px rgba(34,211,238,.5), 0 0 18px -2px rgba(34,211,238,.4); background:var(--glass-soft); }

.cat-ic{ width:37px; height:37px; flex:0 0 37px; border-radius:13px; display:grid; place-items:center;
  background:linear-gradient(135deg,rgba(34,211,238,.16),rgba(167,139,250,.14));
  border:1px solid var(--stroke); color:#8fd8ff; }
.cat-ic svg{ width:18px; height:18px; }
.cat-name{ flex:1; min-width:0; font-size:14px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.cat-badge{ font-size:11px; font-weight:700; color:var(--muted); padding:3px 9px; border-radius:99px;
  background:var(--glass-soft); border:1px solid var(--stroke); }
.cat-row.active .cat-badge{ color:var(--text); border-color:rgba(34,211,238,.4); }

/* ADULT özel satır */
.cat-row.adult .cat-ic{ background:linear-gradient(135deg,rgba(251,77,109,.2),rgba(244,114,182,.12)); color:#ff8fa8; }
.cat-row.adult.active{ background:linear-gradient(90deg,rgba(251,77,109,.14),rgba(244,114,182,.06)); border-color:rgba(251,77,109,.35); }
.cat-row.adult::before{ background:linear-gradient(180deg,var(--danger),var(--a3)); box-shadow:0 0 12px var(--danger); }
.cat-row.adult .cat-badge{ color:#ff9fb2; border-color:rgba(251,77,109,.35); }
.cat-row.adult .lock{ width:15px; height:15px; color:#ff8fa8; opacity:.8; }

/* ══════════════════════════════════════════════
   ANA İÇERİK + KARTLAR
   ══════════════════════════════════════════════ */
main{ position:relative; z-index:10; max-width:1360px; margin:0 auto; padding:116px 26px 90px; }

.page-head{ display:flex; align-items:flex-end; justify-content:space-between; gap:14px; margin:6px 2px 26px;
  animation:fadeUp .7s var(--ease) .3s both; }
.page-head h1{ margin:0; font-size:clamp(24px,3.4vw,38px); font-weight:800; letter-spacing:-.01em; }
.page-head h1 span{ background:linear-gradient(100deg,var(--a1),var(--a2) 60%,var(--a3));
  -webkit-background-clip:text; background-clip:text; color:transparent; }
.count-chip{ display:inline-flex; align-items:center; gap:8px; font-size:12.5px; font-weight:700; color:var(--muted);
  padding:8px 15px; border-radius:999px; background:var(--glass-soft); border:1px solid var(--stroke);
  backdrop-filter:blur(10px); white-space:nowrap; }
.count-chip i{ width:7px; height:7px; border-radius:50%; background:var(--a1); box-shadow:0 0 10px var(--a1); animation:pulse 2s infinite; }
@keyframes pulse{ 50%{ opacity:.4; } }

/* Grid */
.grid{ display:grid; gap:20px; grid-template-columns:repeat(auto-fill,minmax(152px,1fr)); }

.card{ position:relative; cursor:pointer; outline-offset:4px;
  animation:cardIn .6s var(--ease) both; animation-delay:var(--d,0ms); }
@keyframes cardIn{ from{ opacity:0; transform:translateY(16px) scale(.94);} to{ opacity:1; transform:none;} }

.thumb{ position:relative; aspect-ratio:16/9; border-radius:20px; overflow:hidden;
  border:1px solid var(--stroke); background:var(--thumb-base);
  box-shadow:0 10px 30px -14px rgba(0,0,0,.55);
  transition:transform .4s var(--ease), box-shadow .4s var(--ease), border-color .35s; }
.thumb .lts{ position:absolute; inset:0; display:grid; place-items:center;
  font-size:clamp(22px,2.6vw,32px); font-weight:800; letter-spacing:.08em;
  background:linear-gradient(120deg,rgba(224,242,254,.85),rgba(196,181,253,.8));
  -webkit-background-clip:text; background-clip:text; color:transparent;
  text-shadow:none; filter:drop-shadow(0 2px 10px rgba(0,0,0,.35)); }
.thumb img{ position:absolute; inset:0; width:100%; height:100%; object-fit:contain; padding:17%;
  filter:drop-shadow(0 5px 16px rgba(0,0,0,.55)); transition:transform .45s var(--ease), opacity .4s; opacity:0; }
.thumb img.ok{ opacity:1; }
.thumb img.err{ display:none; }

.card:hover .thumb, .card.kv-focus .thumb{
  transform:translateY(-7px) scale(1.06);
  border-color:rgba(34,211,238,.65);
  box-shadow:0 0 0 1px rgba(34,211,238,.35), 0 22px 44px -12px rgba(34,211,238,.35), 0 0 30px -4px rgba(167,139,250,.3); }
.card:hover .thumb img, .card.kv-focus .thumb img{ transform:scale(1.07); }

.fav{ position:absolute; top:9px; right:9px; z-index:3; width:32px; height:32px; border-radius:12px;
  display:grid; place-items:center; cursor:pointer; color:#fff;
  background:rgba(10,12,25,.45); border:1px solid rgba(255,255,255,.16);
  backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px);
  transition:transform .3s var(--ease-b), background .3s, color .3s, box-shadow .3s; }
.fav svg{ width:16px; height:16px; }
.fav:hover{ transform:scale(1.15); box-shadow:0 0 16px rgba(244,114,182,.5); }
.fav.on{ color:#ff6b9d; background:rgba(60,14,34,.6); border-color:rgba(244,114,182,.5); }
.fav.on svg{ fill:#ff6b9d; }

.play-chip{ position:absolute; inset:0; z-index:2; display:grid; place-items:center;
  opacity:0; transform:scale(.6); transition:opacity .35s var(--ease), transform .4s var(--ease-b); pointer-events:none; }
.card:hover .play-chip, .card.kv-focus .play-chip{ opacity:1; transform:scale(1); }
.play-chip i{ width:52px; height:52px; border-radius:50%; display:grid; place-items:center;
  background:rgba(10,14,30,.55); border:1px solid rgba(255,255,255,.25);
  backdrop-filter:blur(10px); box-shadow:0 0 30px rgba(34,211,238,.45); color:#eaffff; }
.play-chip svg{ width:21px; height:21px; margin-left:2px; fill:currentColor; }

.cname{ margin:11px 4px 0; font-size:13.5px; font-weight:600; letter-spacing:.01em;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.cname small{ display:block; margin-top:2px; font-size:11px; font-weight:500; color:var(--muted); }

/* Liste görünümü */
.grid.list{ display:flex; flex-direction:column; gap:13px; }
.grid.list .card{ display:flex; align-items:center; gap:17px; padding:11px 16px 11px 11px;
  border-radius:22px; background:var(--glass-soft); border:1px solid var(--stroke);
  backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  transition:transform .35s var(--ease), border-color .3s, box-shadow .35s; }
.grid.list .card:hover, .grid.list .card.kv-focus{ transform:translateX(6px);
  border-color:rgba(34,211,238,.5); box-shadow:0 0 0 1px rgba(34,211,238,.25), 0 14px 34px -14px rgba(34,211,238,.35); }
.grid.list .thumb{ width:168px; flex:0 0 168px; border-radius:15px; }
.grid.list .card:hover .thumb{ transform:none; }
.grid.list .cname{ margin:0; flex:1; font-size:15.5px; white-space:normal; }
.grid.list .fav{ position:static; flex:0 0 38px; width:38px; height:38px; border-radius:14px; }
.grid.list .play-chip{ display:none; }

/* Yükleniyor / boş durum */
.state-box{ display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px;
  padding:80px 20px; text-align:center; color:var(--muted); }
.state-box .spin{ width:52px; height:52px; border-radius:50%; border:3px solid transparent;
  border-top-color:var(--a1); border-right-color:var(--a2); animation:spin 1s linear infinite;
  filter:drop-shadow(0 0 12px rgba(34,211,238,.5)); }
.state-box .ic{ width:64px; height:64px; border-radius:22px; display:grid; place-items:center;
  background:var(--glass-soft); border:1px solid var(--stroke); color:var(--muted); }
.state-box .ic svg{ width:28px; height:28px; }
.state-box b{ color:var(--text); font-size:17px; }
.state-box p{ margin:0; font-size:13.5px; max-width:340px; line-height:1.55; }

/* ══════════════════════════════════════════════
   MODALLAR (Adult şifre + Oynatıcı)
   ══════════════════════════════════════════════ */
.modal{ position:fixed; inset:0; z-index:200; display:grid; place-items:center; padding:20px;
  background:rgba(3,5,12,.6); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);
  opacity:0; pointer-events:none; transition:opacity .4s ease; }
.modal.show{ opacity:1; pointer-events:auto; }
.modal .panel{ transform:translateY(18px) scale(.96); transition:transform .45s var(--ease-b);
  background:var(--glass-strong); border:1px solid var(--stroke-hi); border-radius:28px;
  backdrop-filter:blur(30px) saturate(180%); -webkit-backdrop-filter:blur(30px) saturate(180%);
  box-shadow:var(--shadow); }
.modal.show .panel{ transform:none; }

/* Adult şifre paneli */
#adultModal .panel{ width:min(400px,100%); padding:30px 28px 26px;
  border-color:rgba(251,77,109,.45); box-shadow:0 0 0 1px rgba(251,77,109,.2), var(--shadow), 0 0 60px -10px rgba(251,77,109,.35); }
#adultModal.shake .panel{ animation:shake .5s var(--ease); }
@keyframes shake{ 20%{transform:translateX(-10px)} 40%{transform:translateX(9px)} 60%{transform:translateX(-6px)} 80%{transform:translateX(4px)} }
.ad-ic{ width:58px; height:58px; margin:0 auto 16px; border-radius:20px; display:grid; place-items:center;
  background:linear-gradient(135deg,rgba(251,77,109,.25),rgba(244,114,182,.15));
  border:1px solid rgba(251,77,109,.4); color:#ff8fa8; box-shadow:0 0 26px -4px rgba(251,77,109,.5); }
.ad-ic svg{ width:26px; height:26px; }
#adultModal h3{ margin:0 0 7px; text-align:center; font-size:19px; font-weight:800; }
#adultModal .sub{ margin:0 0 22px; text-align:center; font-size:13px; color:var(--muted); }
#adultPass{ width:100%; padding:15px; text-align:center; font-size:21px; font-weight:700; letter-spacing:.55em; text-indent:.55em;
  border-radius:16px; color:var(--text); background:var(--input-bg); border:1px solid var(--stroke-hi); outline:0;
  transition:border-color .3s, box-shadow .3s; }
#adultPass:focus{ border-color:rgba(251,77,109,.6); box-shadow:0 0 0 1px rgba(251,77,109,.35), 0 0 24px -4px rgba(251,77,109,.4); }
.ad-err{ min-height:20px; margin:10px 2px 4px; font-size:12.5px; font-weight:600; color:#ff7d95; text-align:center; opacity:0; transition:opacity .3s; }
.ad-err.show{ opacity:1; }
.ad-btns{ display:flex; gap:11px; margin-top:8px; }
.btn{ flex:1; padding:13px; border-radius:15px; font-size:14px; font-weight:700; letter-spacing:.04em; cursor:pointer;
  border:1px solid var(--stroke-hi); background:var(--glass-soft); color:var(--text);
  transition:transform .3s var(--ease), box-shadow .3s, filter .3s; }
.btn:hover{ transform:translateY(-2px); }
.btn.grad{ border:0; color:#fff; background:linear-gradient(100deg,var(--danger),var(--a3));
  box-shadow:0 8px 24px -6px rgba(251,77,109,.55); }
.btn.grad:hover{ filter:brightness(1.12); box-shadow:0 10px 30px -6px rgba(244,114,182,.65); }

/* Oynatıcı modalı */
#playerModal .panel{ width:min(980px,100%); overflow:hidden; }
.pl-head{ display:flex; align-items:center; gap:13px; padding:16px 18px; border-bottom:1px solid var(--stroke); }
.pl-head img{ width:38px; height:38px; object-fit:contain; border-radius:11px; background:rgba(255,255,255,.06); padding:4px; }
.pl-head h3{ flex:1; margin:0; font-size:16px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.pl-live{ font-size:10.5px; font-weight:800; letter-spacing:.14em; color:#ff5c7a; border:1px solid rgba(251,77,109,.5);
  padding:4px 10px; border-radius:99px; display:flex; align-items:center; gap:6px; }
.pl-live i{ width:6px; height:6px; border-radius:50%; background:#ff5c7a; box-shadow:0 0 8px #ff5c7a; animation:pulse 1.4s infinite; }
.pl-body{ position:relative; background:#000; aspect-ratio:16/9; }
.pl-body video, .pl-body iframe{ width:100%; height:100%; border:0; display:block; background:#000; }
.pl-spin{ position:absolute; inset:0; display:grid; place-items:center; background:rgba(0,0,0,.35); pointer-events:none; transition:opacity .4s; }
.pl-spin.hide{ opacity:0; }
.pl-spin .spin{ width:46px; height:46px; border-radius:50%; border:3px solid transparent; border-top-color:var(--a1); border-right-color:var(--a3); animation:spin 1s linear infinite; }
.pl-err{ position:absolute; inset:auto 0 0 0; padding:12px 16px; font-size:12.5px; color:#ffb3c0; background:linear-gradient(transparent,rgba(0,0,0,.85)); opacity:0; transition:opacity .4s; }
.pl-err.show{ opacity:1; }

/* Toast */
#toast{ position:fixed; bottom:26px; left:50%; transform:translate(-50%,80px); z-index:300;
  display:flex; align-items:center; gap:10px; padding:12px 20px; border-radius:999px;
  font-size:13px; font-weight:600; color:var(--text);
  background:var(--glass-strong); border:1px solid var(--stroke-hi);
  backdrop-filter:blur(20px); box-shadow:var(--shadow);
  transition:transform .5s var(--ease-b); pointer-events:none; }
#toast.show{ transform:translate(-50%,0); }
#toast svg{ width:16px; height:16px; color:var(--a1); }

/* ─ Responsive ─ */
@media (max-width:680px){
  .brand b{ display:none; }
  .search{ max-width:150px; } .search:focus-within{ max-width:190px; }
  main{ padding:104px 16px 70px; }
  .grid{ grid-template-columns:repeat(auto-fill,minmax(108px,1fr)); gap:13px; }
  .grid.list .thumb{ width:118px; flex-basis:118px; }
  .tbtn{ width:41px; height:41px; flex-basis:41px; }
}
@media (min-width:1600px){ .grid{ grid-template-columns:repeat(auto-fill,minmax(178px,1fr)); } }
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{ animation-duration:.01ms !important; transition-duration:.01ms !important; }
}
</style>
</head>
<body>

<!-- ═══════ SPLASH / INTRO ═══════ -->
<div id="splash" role="status" aria-label="Yükleniyor">
  <div class="splash-wrap">
    <div class="splash-ring"></div>
    <div class="splash-ring r2"></div>
    <div class="splash-ring r3"></div>
    <img class="splash-logo" src="https://i.ibb.co/dwQVHXDk/1791884526707.png" alt="Max Tv Logo">
    <div class="splash-txt">Max Tv</div>
  </div>
</div>

<!-- ═══════ AMBİYANS ═══════ -->
<div class="aurora a"></div><div class="aurora b"></div><div class="aurora c"></div>

<!-- ═══════ TOPBAR ═══════ -->
<header id="topbar">
  <button id="burgerBtn" class="tbtn" aria-label="Menüyü aç/kapat" tabindex="0">
    <span class="burger" id="burgerIcon"><span></span><span></span><span></span></span>
  </button>

  <a class="brand" href="#" id="brandLink" aria-label="Max Tv ana sayfa">
    <img src="https://i.ibb.co/dwQVHXDk/1791884526707.png" alt="Max Tv">
    <b>Max Tv</b>
  </a>

  <div class="search" role="search">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
    <input id="searchInput" type="text" placeholder="Kanal ara..." aria-label="Kanal ara" autocomplete="off">
  </div>

  <div class="top-actions">
    <button id="viewBtn" class="tbtn" aria-label="Görünüm değiştir" tabindex="0"></button>
    <button id="themeBtn" class="tbtn" aria-label="Tema değiştir" tabindex="0"></button>
    <a class="tbtn" href="tg://resolve?domain=Vivo_X_Medya" aria-label="Telegram kanalımız" tabindex="0">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4Z"/></svg>
    </a>
  </div>
</header>

<!-- ═══════ SIDEBAR ═══════ -->
<div id="overlay"></div>
<aside id="sidebar" aria-label="Kategoriler">
  <div class="side-head"><h2>Kategoriler</h2><div class="line"></div></div>
  <nav class="cats" id="catList"></nav>
</aside>

<!-- ═══════ ANA İÇERİK ═══════ -->
<main>
  <div class="page-head">
    <h1 id="pageTitle">Kanallar</h1>
    <span class="count-chip"><i></i><span id="pageCount">0 kanal</span></span>
  </div>

  <div id="content">
    <div class="state-box" id="loadingBox">
      <div class="spin"></div>
      <b>Kanallar yükleniyor</b>
      <p>Firebase bağlantısı kuruluyor, lütfen bekleyin...</p>
    </div>
  </div>
</main>

<!-- ═══════ ADULT ŞİFRE MODALI ═══════ -->
<div class="modal" id="adultModal" role="dialog" aria-modal="true" aria-labelledby="adultTitle">
  <div class="panel">
    <div class="ad-ic">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
    </div>
    <h3 id="adultTitle">Adult Bölümü · 18+</h3>
    <p class="sub">Bu bölüme girmek için şifre gereklidir</p>
    <input id="adultPass" type="password" inputmode="numeric" pattern="[0-9]*" maxlength="8" placeholder="••••" aria-label="Adult bölümü şifresi" autocomplete="off">
    <div class="ad-err" id="adultErr">Şifre hatalı, tekrar deneyin</div>
    <div class="ad-btns">
      <button class="btn" id="adultCancel">İptal</button>
      <button class="btn grad" id="adultGo">Giriş</button>
    </div>
  </div>
</div>

<!-- ═══════ OYNATICI MODALI ═══════ -->
<div class="modal" id="playerModal" role="dialog" aria-modal="true" aria-label="Kanal oynatıcı">
  <div class="panel">
    <div class="pl-head">
      <img id="plLogo" alt="" onerror="this.style.visibility='hidden'">
      <h3 id="plName">Kanal</h3>
      <span class="pl-live"><i></i>CANLI</span>
      <button class="tbtn" id="plClose" aria-label="Kapat" tabindex="0">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="pl-body" id="plBody">
      <video id="plVideo" controls playsinline></video>
      <div class="pl-spin" id="plSpin"><div class="spin"></div></div>
      <div class="pl-err" id="plErr">Yayın yüklenemedi. Bağlantıyı kontrol edip tekrar deneyin.</div>
    </div>
  </div>
</div>

<!-- ═══════ TOAST ═══════ -->
<div id="toast" role="status"></div>

<script type="module">
/* ════════════════════════════════════════════════════
   Max Tv — UYGULAMA MANTIĞI
   Firebase RTDB • Spatial UI • TV Navigasyonu
   ════════════════════════════════════════════════════ */
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import { getDatabase, ref, onValue } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js";

/* ── Firebase ── */
const firebaseConfig = {
  apiKey: "AIzaSyA9iUuAMK4hrqLQEARG-4IjBrOSzaIIDQk",
  authDomain: "kazan-beab9.firebaseapp.com",
  databaseURL: "https://kazan-beab9-default-rtdb.firebaseio.com",
  projectId: "kazan-beab9",
  storageBucket: "kazan-beab9.appspot.com",
  messagingSenderId: "278987454292",
  appId: "1:278987454292:web:7e8400b4e43fd0fb847ac1"
};
const app = initializeApp(firebaseConfig);
const db  = getDatabase(app);

/* ── Yardımcılar ── */
const $  = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
/* Türkçe karakter dönüşümlü slugify */
const TR = {'ç':'c','ğ':'g','ı':'i','ö':'o','ş':'s','ü':'u'};
const slugify = s => String(s ?? '').toLocaleLowerCase('tr').split('').map(c => TR[c] ?? c).join('')
  .replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'');
const lsGet = (k,d)=>{ try{ const v=localStorage.getItem(k); return v==null?d:JSON.parse(v);}catch(e){return d;} };
const lsSet = (k,v)=>{ try{ localStorage.setItem(k,JSON.stringify(v)); }catch(e){} };

/* ── Durum ── */
const state = {
  cats: [],            // firebase kategorileri
  channels: [],        // normal kanallar
  adult: [],           // adult kanallar
  adultPass: null,     // adult şifre
  adultOK: false,      // oturumda açıldı mı
  sel: null,           // seçili kategori: 'favs' | 'adult' | slug
  q: '',               // arama
  view: lsGet('fplay_view','grid'),
  favs: new Set(lsGet('fplay_favs',[])),
  ready: false,
  // klavye/kumanda
  area: 'grid',        // 'grid' | 'sidebar' | 'topbar'
  gi: 0, si: 0, ti: 1  // grid index, sidebar index, topbar index
};

/* ── SVG ikon kütüphanesi ── */
const IC = {
  heart:  '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
  news:   '<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0V9"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/>',
  doc:    '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>',
  film:   '<path d="M20.2 6 3 11l-.9-2.4c-.3-1.1.3-2.2 1.3-2.5l13.5-4c1.1-.3 2.2.3 2.5 1.3Z"/><path d="m6.2 5.3 3.1 3.9"/><path d="m12.4 3.4 3.1 4"/><path d="M3 11h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/>',
  sport:  '<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>',
  kids:   '<circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><path d="M9 9h.01"/><path d="M15 9h.01"/>',
  music:  '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
  moon:   '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/><path d="M19 3v4"/><path d="M21 5h-4"/>',
  tv:     '<rect x="2" y="7" width="20" height="15" rx="2"/><path d="m17 2-5 5-5-5"/>',
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="M12 8v4"/><path d="M12 16h.01"/>',
  radio:  '<path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"/><path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"/><path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"/><path d="M19.1 4.9C23 8.8 23 15.1 19.1 19.1"/><circle cx="12" cy="12" r="2"/>',
  grid:   '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  list:   '<path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/>',
  sun:    '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.9 4.9 1.4 1.4"/><path d="m17.7 17.7 1.4 1.4"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.3 17.7-1.4 1.4"/><path d="m19.1 4.9-1.4 1.4"/>',
  moonT:  '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
  play:   '<path d="m6 4 14 8-14 8V4Z"/>',
  lock:   '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  ghost:  '<circle cx="12" cy="12" r="9"/><path d="m9 10 6 4M15 10l-6 4"/>',
  check:  '<path d="M20 6 9 17l-5-5"/>',
  heartF: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>'
};
const svg = (n, extra='') => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ${extra}>${IC[n]||IC.tv}</svg>`;
/* Kategori adına göre otomatik ikon */
function iconFor(name){
  const s = slugify(name);
  if(s.includes('favori')) return 'heart';
  if(s.includes('haber')) return 'news';
  if(s.includes('belgesel')) return 'doc';
  if(s.includes('sinema')||s.includes('film')||s.includes('dizi')) return 'film';
  if(s.includes('spor')) return 'sport';
  if(s.includes('cocuk')||s.includes('cizgi')) return 'kids';
  if(s.includes('muzik')) return 'music';
  if(s.includes('dini')||s==='din'||s.startsWith('din-')) return 'moon';
  if(s.includes('ulusal')||s.includes('yerel')) return 'tv';
  if(s.includes('adult')||s.includes('18')) return 'shield';
  if(s.includes('radyo')) return 'radio';
  return 'tv';
}

/* ── Logo cache (localStorage) + renk çıkarma ── */
const memLogos = new Map();   // url → dataURL | 'FAIL'
const LOGO_PREFIX = 'fplay_logo_';

function logoFromStorage(url){
  try{ return localStorage.getItem(LOGO_PREFIX + url); }catch(e){ return null; }
}
function logoToStorage(url, dataUrl){
  try{
    localStorage.setItem(LOGO_PREFIX + url, dataUrl);
  }catch(e){
    // Kota dolarsa eski logoların yarısını temizleyip bir kez daha dene
    try{
      const keys = Object.keys(localStorage).filter(k => k.startsWith(LOGO_PREFIX));
      keys.slice(0, Math.ceil(keys.length/2)).forEach(k => localStorage.removeItem(k));
      localStorage.setItem(LOGO_PREFIX + url, dataUrl);
    }catch(_){}
  }
}
/* Blob → küçültülmüş dataURL (localStorage dostu) */
function blobToDataUrl(blob, max=200){
  return new Promise((res, rej)=>{
    const img = new Image();
    const objUrl = URL.createObjectURL(blob);
    img.onload = () => {
      try{
        const w = img.naturalWidth, h = img.naturalHeight;
        const r = Math.min(1, max / Math.max(w,h));
        const c = document.createElement('canvas');
        c.width = Math.max(1, Math.round(w*r)); c.height = Math.max(1, Math.round(h*r));
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
        URL.revokeObjectURL(objUrl);
        res(c.toDataURL('image/png'));
      }catch(e){ URL.revokeObjectURL(objUrl); rej(e); }
    };
    img.onerror = e => { URL.revokeObjectURL(objUrl); rej(e); };
    img.src = objUrl;
  });
}
/* Logo yoksa harfler gösterilir, thumb arka planı Canvas ortalama renkle boyanır */
function colorizeThumb(img, thumb){
  try{
    const c = document.createElement('canvas'); c.width = 24; c.height = 14;
    const ctx = c.getContext('2d', { willReadFrequently:true });
    ctx.drawImage(img, 0, 0, 24, 14);
    const avg = (x,w) => {
      const d = ctx.getImageData(x,0,w,14).data; let r=0,g=0,b=0,n=0;
      for(let i=0;i<d.length;i+=4){ r+=d[i]; g+=d[i+1]; b+=d[i+2]; n++; }
      return [Math.round(r/n), Math.round(g/n), Math.round(b/n)];
    };
    const c1 = avg(0,12), c2 = avg(12,12);
    thumb.style.background =
      `linear-gradient(120deg, rgba(${c1},.75) 0%, rgba(${c2},.55) 100%), linear-gradient(160deg, var(--card-fb-1), var(--card-fb-2))`;
  }catch(e){ /* CORS engellerse fallback gradient kalır */ }
}
/* Görseli yükle: önce cache → sonra ağdan çekip cache'le → olmazsa doğrudan URL */
async function hydrateLogo(img, thumb){
  const url = img.dataset.logo;
  if(!url){ img.classList.add('err'); return; }

  const show = src => {
    // Dinleyiciyi src atamadan ÖNCE bağla (data: URL'ler anında yüklenebilir)
    if(src.startsWith('data:')){
      if(img.complete && img.naturalWidth) colorizeThumb(img, thumb);
      else img.addEventListener('load', () => colorizeThumb(img, thumb), { once:true });
    }
    img.src = src;
    img.classList.add('ok');
  };

  // 1) Bellek / localStorage cache
  let cached = memLogos.get(url);
  if(cached === undefined){ cached = logoFromStorage(url); if(cached) memLogos.set(url, cached); }
  if(cached && cached !== 'FAIL'){ show(cached); return; }

  // 2) Ağdan indir (CORS izinliyse) → cache'le
  try{
    const resp = await fetch(url, { mode:'cors', cache:'force-cache' });
    if(!resp.ok) throw new Error('http');
    const du = await blobToDataUrl(await resp.blob());
    if(du.length < 180000){ logoToStorage(url, du); memLogos.set(url, du); show(du); }
    else show(url); // çok büyükse cache'leme
  }catch(e){
    // 3) CORS yok → doğrudan göster (renk çıkarımı atlanır)
    memLogos.set(url, 'FAIL');
    show(url);
  }
}

/* ── Toast ── */
let toastT;
function toast(msg, icon='check'){
  const t = $('#toast');
  t.innerHTML = svg(icon) + esc(msg);
  t.classList.add('show');
  clearTimeout(toastT);
  toastT = setTimeout(()=> t.classList.remove('show'), 2200);
}

/* ── Veri normalizasyonu ── */
const normalize = v => !v ? [] : Object.entries(v)
  .map(([id,x]) => ({ id, ...(typeof x==='object' && x ? x : { name:String(x) }) }))
  .filter(x => x.active !== false)
  .sort((a,b) => (a.order ?? 9999) - (b.order ?? 9999) || String(a.name).localeCompare(String(b.name),'tr'));

/* Kanal kimliği (favoriler için stabil) */
const chId = (c, adult=false) => (adult?'a:':'c:') + (c.id || slugify(c.name));

/* Görünür kanal listesi */
function visibleChannels(){
  let list = [];
  if(state.sel === 'favs'){
    list = [
      ...state.channels .map(c => ({...c, _id:chId(c),        _cat: c.category })),
      ...state.adult    .map(c => ({...c, _id:chId(c,true),   _cat:'ADULT'    }))
    ].filter(c => state.favs.has(c._id));
  } else if(state.sel === 'adult'){
    list = state.adult.map(c => ({...c, _id:chId(c,true), _cat:'ADULT'}));
  } else {
    list = state.channels
      .filter(c => slugify(c.category) === state.sel)
      .map(c => ({...c, _id:chId(c), _cat:c.category}));
  }
  const q = slugify(state.q);
  if(q) list = list.filter(c => slugify(c.name).includes(q));
  return list;
}

/* ── SIDEBAR render ── */
function renderSidebar(){
  const rows = [];
  // Favoriler her zaman en üstte (kalp ikonu)
  rows.push(catRow('favs', 'Favoriler', visibleCountFor('favs'), 'heart', false));

  state.cats.forEach(cat => {
    const slug = slugify(cat.name);
    rows.push(catRow(slug, cat.name, visibleCountFor(slug), iconFor(cat.name)));
  });

  // Adult kanal varsa ADULT kategorisini otomatik ekle
  if(state.adult.length){
    rows.push(catRow('adult','ADULT', state.adult.length, 'shield', true));
  }
  $('#catList').innerHTML = rows.join('');
}
function visibleCountFor(key){
  if(key==='favs'){
    const known = new Set([...state.channels.map(c=>chId(c)), ...state.adult.map(c=>chId(c,true))]);
    return [...state.favs].filter(id=>known.has(id)).length;
  }
  if(key==='adult') return state.adult.length;
  return state.channels.filter(c => slugify(c.category)===key).length;
}
function catRow(key, name, count, icon, adult=false){
  const act = state.sel===key ? ' active' : '';
  const lock = adult && !state.adultOK ? `<span class="lock">${svg('lock')}</span>` : '';
  return `<button class="cat-row${adult?' adult':''}${act}" data-cat="${key}" tabindex="0" aria-label="${esc(name)} kategorisi, ${count} kanal">
    <span class="cat-ic">${svg(icon)}</span>
    <span class="cat-name">${esc(name)}</span>
    ${lock || `<span class="cat-badge">${count}</span>`}
  </button>`;
}

/* ── KANAL KARTLARI render ── */
function renderContent(){
  const list = visibleChannels();
  const box  = $('#content');

  if(!state.ready){
    box.innerHTML = `<div class="state-box"><div class="spin"></div><b>Kanallar yükleniyor</b><p>Firebase bağlantısı kuruluyor, lütfen bekleyin...</p></div>`;
    return;
  }
  if(!list.length){
    const isSearch = !!state.q, isFav = state.sel==='favs';
    box.innerHTML = `<div class="state-box">
      <div class="ic">${svg(isSearch ? 'ghost' : (isFav ? 'heart' : 'tv'))}</div>
      <b>${isSearch ? 'Sonuç bulunamadı' : isFav ? 'Henüz favori kanal yok' : 'Bu kategoride kanal yok'}</b>
      <p>${isSearch ? `“${esc(state.q)}” aramasıyla eşleşen kanal bulunamadı. Farklı bir kelime deneyin.`
        : isFav ? 'Kanal kartlarındaki kalp simgesine dokunarak favorilerinizi buraya ekleyebilirsiniz.'
        : 'Bu kategoriye henüz aktif kanal eklenmemiş.'}</p></div>`;
    updateHead(list);
    return;
  }

  const grid = document.createElement('div');
  grid.className = 'grid' + (state.view==='list' ? ' list' : '');
  grid.innerHTML = list.map((c,i) => {
    const name = esc(c.name || 'İsimsiz');
    const lts  = esc(String(c.name||'?').trim().slice(0,4).toLocaleUpperCase('tr'));
    const fav  = state.favs.has(c._id);
    return `<div class="card" data-i="${i}" data-id="${esc(c._id)}" tabindex="0" role="button" aria-label="${name} kanalını aç">
      <div class="thumb">
        <span class="lts">${lts}</span>
        <img data-logo="${esc(c.logo||'')}" alt="" draggable="false">
        <button class="fav${fav?' on':''}" data-fav="${esc(c._id)}" aria-label="${name} favorilere ${fav?'ekli, çıkar':'ekle'}" tabindex="-1">${svg('heart')}</button>
        <span class="play-chip"><i>${svg('play')}</i></span>
      </div>
      <div class="cname">${name}<small>${esc(c._cat && c._cat!=='ADULT' ? (state.cats.find(x=>slugify(x.name)===slugify(c._cat))?.name || c._cat) : (c._cat==='ADULT'?'Adult':''))}</small></div>
    </div>`;
  }).join('');

  box.innerHTML = '';
  box.appendChild(grid);

  // sırayla giriş animasyonu (stagger)
  grid.querySelectorAll('.card').forEach((el,i)=> el.style.setProperty('--d', `${Math.min(i,24)*38}ms`));
  // logoları hydrate et
  grid.querySelectorAll('.card').forEach(card => {
    const img = card.querySelector('img');
    hydrateLogo(img, card.querySelector('.thumb'));
    img.addEventListener('error', () => img.classList.add('err'), { once:true });
    img.addEventListener('load',  () => img.classList.add('ok'),  { once:true });
  });
  state.gi = Math.min(state.gi, Math.max(0, list.length-1));
  updateHead(list);
}
function updateHead(list){
  let title = 'Kanallar';
  if(state.sel==='favs') title = 'Favoriler';
  else if(state.sel==='adult') title = 'Adult';
  else if(state.sel){ const c = state.cats.find(x=>slugify(x.name)===state.sel); if(c) title = c.name; }
  // Arama aktifse başlığa yansıt
  $('#pageTitle').innerHTML = `<span>${esc(title)}</span>` +
    (state.q ? ` <small style="font-size:.5em;font-weight:600;color:var(--muted);letter-spacing:.02em;">“${esc(state.q)}” için sonuçlar</small>` : '');
  $('#pageCount').textContent = `${list.length} kanal`;
  document.title = `Max Tv — ${title}${state.q ? ' / ' + state.q : ''}`;
}
const renderAll = () => { renderSidebar(); renderContent(); };

/* ── Favoriler ── */
function toggleFav(id, btn){
  if(state.favs.has(id)){ state.favs.delete(id); toast('Favorilerden çıkarıldı','heart'); }
  else{ state.favs.add(id); toast('Favorilere eklendi','heart'); }
  lsSet('fplay_favs', [...state.favs]);
  if(btn){ btn.classList.toggle('on'); }
  renderSidebar();
  if(state.sel==='favs') renderContent();
}

/* ── Sidebar aç/kapa ── */
function setSidebar(open){
  $('#sidebar').classList.toggle('open', open);
  $('#overlay').classList.toggle('show', open);
  $('#burgerIcon').classList.toggle('open', open);
  document.body.style.overflow = open ? 'hidden' : '';
  state.area = open ? 'sidebar' : 'grid';
  clearFocus();
  if(open) focusSidebar();
  else focusGrid();
}
function clearFocus(){ document.querySelectorAll('.kv-focus').forEach(e=>e.classList.remove('kv-focus')); }
function focusGrid(){
  const cards = [...document.querySelectorAll('.card')];
  if(!cards.length) return;
  state.gi = Math.max(0, Math.min(state.gi, cards.length-1));
  const el = cards[state.gi];
  el.classList.add('kv-focus');
  el.scrollIntoView({ block:'nearest', inline:'nearest', behavior:'smooth' });
}
function focusSidebar(){
  const rows = [...document.querySelectorAll('.cat-row')];
  if(!rows.length) return;
  state.si = Math.max(0, Math.min(state.si, rows.length-1));
  rows[state.si].classList.add('kv-focus');
  rows[state.si].scrollIntoView({ block:'nearest', behavior:'smooth' });
}
function focusTopbar(){
  const items = topbarItems();
  if(!items.length) return;
  state.ti = Math.max(0, Math.min(state.ti, items.length-1));
  const el = items[state.ti];
  if(el.id === 'searchInput') el.focus();
  else { el.classList.add('kv-focus'); el.focus?.(); }
}
const topbarItems = () => [$('#burgerBtn'), $('#searchInput'), $('#viewBtn'), $('#themeBtn'), document.querySelector('#topbar a.tbtn')];
const cols = () => {
  const g = document.querySelector('.grid');
  if(!g || state.view==='list') return 1;
  return Math.max(1, getComputedStyle(g).gridTemplateColumns.split(' ').length);
};
function openCard(i){
  const list = visibleChannels();
  const c = list[i];
  if(c) openPlayer(c);
}

/* ── Kategori seçimi ── */
function selectCategory(key){
  if(key==='adult' && !state.adultOK){ openAdultModal(); return; }
  state.sel = key; state.q = ''; $('#searchInput').value = '';
  state.gi = 0;
  setSidebar(false);
  renderAll();
}
function firstCategory(){
  return state.cats.length ? slugify(state.cats[0].name) : 'favs';
}

/* ── ADULT ŞİFRE MODALI ── */
const adultModal = $('#adultModal');
function openAdultModal(){
  adultModal.classList.add('show');
  document.body.style.overflow='hidden';
  $('#adultErr').classList.remove('show');
  $('#adultPass').value='';
  setTimeout(()=> $('#adultPass').focus(), 80);
}
function closeAdultModal(){
  adultModal.classList.remove('show');
  document.body.style.overflow = $('#sidebar').classList.contains('open') ? 'hidden':'';
  focusSidebar();
}
function tryAdultLogin(){
  const val = $('#adultPass').value.trim();
  const pass = state.adultPass;
  if(pass == null){ showAdultErr('Şifre bilgisi henüz yüklenemedi, tekrar deneyin'); return; }
  if(val === String(pass)){
    state.adultOK = true;
    closeAdultModal();
    toast('Adult bölümü açıldı','check');
    state.sel = 'adult'; state.gi = 0;
    renderAll();
    setSidebar(false);
  } else {
    showAdultErr('Şifre hatalı, tekrar deneyin');
  }
}
function showAdultErr(msg){
  $('#adultErr').textContent = msg;
  $('#adultErr').classList.add('show');
  adultModal.classList.remove('shake'); void adultModal.offsetWidth;
  adultModal.classList.add('shake');
  $('#adultPass').value=''; $('#adultPass').focus();
}
$('#adultCancel').addEventListener('click', closeAdultModal);
$('#adultGo').addEventListener('click', tryAdultLogin);
$('#adultPass').addEventListener('keydown', e => { if(e.key==='Enter') tryAdultLogin(); });
adultModal.addEventListener('click', e => { if(e.target===adultModal) closeAdultModal(); });

/* ── OYNATICI ── */
let hls = null;
const playerModal = $('#playerModal');
function openPlayer(c){
  const url = c.url || '';
  $('#plName').textContent = c.name || 'Kanal';
  const lg = $('#plLogo'); lg.style.visibility='visible';
  lg.src = memLogos.get(c.logo) && memLogos.get(c.logo)!=='FAIL' ? memLogos.get(c.logo)
        : logoFromStorage(c.logo||'') || c.logo || '';
  if(!c.logo) lg.style.visibility='hidden';
  $('#plErr').classList.remove('show');
  $('#plSpin').classList.remove('hide');

  const video = $('#plVideo');
  const body  = $('#plBody');
  body.querySelector('iframe')?.remove();
  video.style.display = 'block';
  video.pause(); video.removeAttribute('src'); video.load();
  if(hls){ hls.destroy(); hls = null; }

  // YouTube / embed destek
  const yt = /(?:youtube\.com\/(?:watch\?v=|embed\/|live\/)|youtu\.be\/)([\w-]{6,})/.exec(url);
  if(yt){
    video.style.display='none';
    $('#plSpin').classList.add('hide');
    const f = document.createElement('iframe');
    f.src = `https://www.youtube.com/embed/${yt[1]}?autoplay=1&rel=0`;
    f.allow = 'autoplay; encrypted-media; fullscreen'; f.allowFullscreen = true;
    body.insertBefore(f, $('#plSpin'));
  } else if(/\.m3u8(\?|$)/i.test(url) && window.Hls && Hls.isSupported()){
    hls = new Hls({ maxBufferLength:25, liveSyncDurationCount:3 });
    hls.loadSource(url); hls.attachMedia(video);
    hls.on(Hls.Events.MANIFEST_PARSED, ()=> video.play().catch(()=>{}));
    hls.on(Hls.Events.ERROR, (e,d)=>{ if(d?.fatal){ videoError(); } });
  } else {
    video.src = url; // Safari (native HLS) veya mp4 vb.
    video.play().catch(()=>{});
  }
  video.onplaying = ()=> $('#plSpin').classList.add('hide');
  video.onerror   = ()=> videoError();
  setTimeout(()=> $('#plSpin').classList.add('hide'), 9000);

  playerModal.classList.add('show');
  document.body.style.overflow='hidden';
  setSidebar(false);
}
function videoError(){
  $('#plSpin').classList.add('hide');
  $('#plErr').classList.add('show');
}
function closePlayer(){
  const video = $('#plVideo');
  video.pause(); video.removeAttribute('src'); video.load();
  if(hls){ hls.destroy(); hls = null; }
  $('#plBody').querySelector('iframe')?.remove();
  playerModal.classList.remove('show');
  document.body.style.overflow='';
  focusGrid();
}
$('#plClose').addEventListener('click', closePlayer);
playerModal.addEventListener('click', e => { if(e.target===playerModal) closePlayer(); });

/* ── Tema / Görünüm / Tercihler ── */
function applyThemeIcon(){ $('#themeBtn').innerHTML = svg(document.documentElement.dataset.theme==='light' ? 'moonT' : 'sun'); }
function applyViewIcon(){ $('#viewBtn').innerHTML = svg(state.view==='grid' ? 'list' : 'grid'); }
$('#themeBtn').addEventListener('click', ()=>{
  const next = document.documentElement.dataset.theme==='light' ? 'dark' : 'light';
  document.documentElement.dataset.theme = next;
  lsSet('fplay_theme', next);
  applyThemeIcon();
  toast(next==='light' ? 'Açık tema aktif' : 'Koyu tema aktif','sun');
});
$('#viewBtn').addEventListener('click', ()=>{
  state.view = state.view==='grid' ? 'list' : 'grid';
  lsSet('fplay_view', state.view);
  applyViewIcon(); renderContent();
});

/* ── Arama ── */
let searchT;
$('#searchInput').addEventListener('input', e=>{
  clearTimeout(searchT);
  searchT = setTimeout(()=>{ state.q = e.target.value.trim(); state.gi = 0; renderContent(); }, 140);
});
$('#searchInput').addEventListener('keydown', e=>{
  if(e.key==='ArrowDown'){ e.preventDefault(); e.target.blur(); state.area='grid'; clearFocus(); focusGrid(); }
  if(e.key==='Enter'){ const l=visibleChannels(); if(l.length){ e.target.blur(); openCard(0); } }
  if(e.key==='Escape'){ e.target.blur(); state.area='grid'; clearFocus(); focusGrid(); }
});

/* ── Sidebar / overlay olayları ── */
$('#burgerBtn').addEventListener('click', ()=> setSidebar(!$('#sidebar').classList.contains('open')));
$('#overlay').addEventListener('click', ()=> setSidebar(false));
$('#catList').addEventListener('click', e=>{
  const row = e.target.closest('.cat-row');
  if(row) selectCategory(row.dataset.cat);
});

/* ── Kart tıklama (delegasyon) ── */
$('#content').addEventListener('click', e=>{
  const favBtn = e.target.closest('.fav');
  if(favBtn){ e.stopPropagation(); toggleFav(favBtn.dataset.fav, favBtn); return; }
  const card = e.target.closest('.card');
  if(card){ state.gi = +card.dataset.i; openCard(state.gi); }
});
$('#content').addEventListener('keydown', e=>{
  const card = e.target.closest('.card');
  if(card && (e.key==='Enter' || e.key===' ')){ e.preventDefault(); openCard(+card.dataset.i); }
});
$('#brandLink').addEventListener('click', e=>{ e.preventDefault(); state.sel = firstCategory(); state.q=''; $('#searchInput').value=''; renderAll(); });

/* ════════════════════════════════════════════════════
   KUMANDA / KLAVYE NAVİGASYONU (TV uyumlu)
   ════════════════════════════════════════════════════ */
function keyOf(e){
  // Android TV remote keyCode desteği
  const kc = e.keyCode;
  if(kc===19) return 'ArrowUp';
  if(kc===20) return 'ArrowDown';
  if(kc===21) return 'ArrowLeft';
  if(kc===22) return 'ArrowRight';
  if(kc===23 || kc===66 || kc===13) return 'Enter';
  if(kc===4)  return 'Back';
  if(kc===27) return 'Back';
  if(e.key==='Escape') return 'Back';
  return e.key;
}
document.addEventListener('keydown', e=>{
  const key = keyOf(e);

  // Modal öncelikleri
  if(playerModal.classList.contains('show')){
    if(key==='Back'){ e.preventDefault(); closePlayer(); }
    return;
  }
  if(adultModal.classList.contains('show')){
    if(key==='Back'){ e.preventDefault(); closeAdultModal(); }
    return;
  }
  if(document.activeElement === $('#searchInput') && (key==='ArrowDown'||key==='Enter'||key==='Back')) return; // input kendi hallediyor
  if(document.activeElement === $('#searchInput')) return;

  // Geri: önce menüyü kapat
  if(key==='Back'){
    if($('#sidebar').classList.contains('open')){ e.preventDefault(); setSidebar(false); }
    return;
  }

  const nav = ['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Enter'].includes(key);
  if(!nav) return;
  e.preventDefault();

  // ── Sidebar açıkken kategori gezinmesi ──
  if(state.area==='sidebar'){
    const rows = document.querySelectorAll('.cat-row');
    if(!rows.length) return;
    clearFocus();
    if(key==='ArrowUp')   state.si = (state.si - 1 + rows.length) % rows.length;
    if(key==='ArrowDown') state.si = (state.si + 1) % rows.length;
    if(key==='ArrowLeft'){ setSidebar(false); return; }
    if(key==='Enter' || key==='ArrowRight'){ const r = rows[state.si]; if(r) selectCategory(r.dataset.cat); return; }
    focusSidebar();
    return;
  }

  // ── Topbar gezinmesi ──
  if(state.area==='topbar'){
    const items = topbarItems();
    clearFocus();
    if(key==='ArrowLeft')  state.ti = (state.ti - 1 + items.length) % items.length;
    if(key==='ArrowRight') state.ti = (state.ti + 1) % items.length;
    if(key==='ArrowDown'){ state.area='grid'; $('#searchInput').blur(); focusGrid(); return; }
    if(key==='Enter'){
      const el = items[state.ti];
      if(el.id==='searchInput'){ el.focus(); return; }
      if(el.id==='burgerBtn'){ setSidebar(true); return; }
      el.click(); return;
    }
    focusTopbar();
    return;
  }

  // ── Grid (kartlar) gezinmesi ──
  const cards = document.querySelectorAll('.card');
  const n = cards.length;
  if(!n) return;
  const c = cols();
  clearFocus();
  if(key==='ArrowRight'){ state.gi = Math.min(n-1, state.gi + 1); }
  if(key==='ArrowLeft'){
    if(state.gi % c === 0){ setSidebar(true); return; }
    state.gi--;
  }
  if(key==='ArrowUp'){
    if(state.gi - c < 0){ state.area='topbar'; state.ti = 1; focusTopbar(); return; }
    state.gi -= c;
  }
  if(key==='ArrowDown'){ state.gi = Math.min(n-1, state.gi + c); }
  if(key==='Enter'){ openCard(state.gi); return; }
  focusGrid();
});

/* ════════════════════════════════════════════════════
   FIREBASE — realtime dinleyiciler
   ════════════════════════════════════════════════════ */
function listen(path, cb, onErr){
  onValue(ref(db, path), snap => cb(snap.val()), err => {
    console.warn('Firebase hata:', path, err?.message||err);
    toast('Veri bağlantısı kurulamadı','ghost');
  });
}
listen('fplay-kategoriler', v => {
  state.cats = normalize(v);
  if(state.sel === null) state.sel = firstCategory();
  state.ready = true; renderAll();
});
listen('fplay-kanallar', v => { state.channels = normalize(v); renderAll(); });
listen('fplay-adult-kanallar', v => { state.adult = normalize(v); renderAll(); });
listen('fplay-adult-sifre', v => {
  state.adultPass = (v && typeof v === 'object')
    ? (v.sifre ?? v.password ?? v.value ?? Object.values(v)[0] ?? null)
    : v;
});

/* ════════════════════════════════════════════════════
   BAŞLANGIÇ
   ════════════════════════════════════════════════════ */
window.addEventListener('DOMContentLoaded', () => {
  applyThemeIcon(); applyViewIcon();
  // Splash: ~1.8 sn sonra yumuşakça kapat
  const t0 = performance.now();
  const hide = () => {
    const wait = Math.max(0, 1800 - (performance.now() - t0));
    setTimeout(()=> $('#splash').classList.add('done'), wait);
  };
  if(document.readyState === 'complete') hide();
  else window.addEventListener('load', hide, { once:true });
  // Güvenlik: en geç 4 sn'de kapanır
  setTimeout(()=> $('#splash').classList.add('done'), 4000);
  focusGrid();
});
</script>
</body>
</html>
